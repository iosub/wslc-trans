<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The executable users run: wslc-ai-agent.exe -->
    <AssemblyName>wslc-ai-agent</AssemblyName>
    <RootNamespace>WslcAgent.Server</RootNamespace>
    <ApplicationIcon>wslc-ai-agent.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WslcAgent.ApiClient\WslcAgent.ApiClient.csproj" />
    <ProjectReference Include="..\WslcAgent.Mcp\WslcAgent.Mcp.csproj" />
    <ProjectReference Include="..\WslcAgent.Web\WslcAgent.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WslcAgent.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The skill an AI client installs travels inside the agent, so what a
         machine hands out is always the skill of the agent it came from: no
         copy of it can be older than the tools it describes. -->
    <EmbeddedResource Include="..\..\mcp-skill\skills\wslc\SKILL.md" LogicalName="wslc-skill.md" />
    <!-- The dashboard a first run starts from travels inside the agent the
         same way (docs/home/spec.md, section 7): a user with no dashboard of
         their own is given this one. -->
    <EmbeddedResource Include="Overview\dashboard.default.json" LogicalName="dashboard.default.json" />
    <!-- How each kind of card ships, designed a card at a time with Save as
         default on a development agent (the owner, 24 September 2026). -->
    <EmbeddedResource Include="Overview\card-defaults.json" LogicalName="card-defaults.json" />
    <!-- How each kind of Home v2's object is born, desktop and mobile,
         designed on the board of every object on a development agent (the
         owner, 26 September 2026). -->
    <EmbeddedResource Include="Overview\object-defaults.json" LogicalName="object-defaults.json" />
    <!-- Home v2.5's dashboard a user with none is given, designed on the
         server's dashboard on a development agent (the owner, 26 September
         2026); blank until one is designed, since v2.5 starts from nothing
         (docs/home/v2.5/spec.md, decision 7). -->
    <EmbeddedResource Include="Overview\dashboard-v2.5.default.json" LogicalName="dashboard-v2.5.default.json" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <!-- While the dashboard is being designed (the owner, 22 September 2026),
         Copy to server on a development agent also writes the default above,
         so the next installer ships it. Only a Debug build knows where that
         file is; a Release build, which is what the installer publishes,
         carries no path and writes no default. -->
    <AssemblyMetadata Include="DashboardDefaultSource" Value="$(MSBuildProjectDirectory)\Overview\dashboard.default.json" />
    <AssemblyMetadata Include="CardDefaultsSource" Value="$(MSBuildProjectDirectory)\Overview\card-defaults.json" />
    <AssemblyMetadata Include="ObjectDefaultsSource" Value="$(MSBuildProjectDirectory)\Overview\object-defaults.json" />
    <AssemblyMetadata Include="DashboardV2DefaultSource" Value="$(MSBuildProjectDirectory)\Overview\dashboard-v2.5.default.json" />
  </ItemGroup>

</Project>
