@* A part's settings inside its card (docs/home/spec.md, section 4): its
   size in the card's cells, columns and rows up to the card's own — the
   finger's way to what the corner handle does with a mouse — and its type
   size. Each change is applied as it is made, so it is seen on the card
   (the owner, 24 September 2026); a size whose cells are taken stays where it
   is and says why. Save keeps what is on the card and closes; Cancel puts the
   card back as it was when the dialog opened; Close asks first when there is
   something to lose, and puts it back too (SaveCancelClose). Hiding the part
   is the card's Settings' business, a box per part under Shows (the owner,
   22 September 2026: it was a verb here too and one place is enough). The
   dialog is as tall and as wide as its three fields, holds nothing of the
   page under it and is moved by its title (DialogFlow.ShowMovableAsync), so
   what it changes stays in sight; its fields never change, so it never grows. *@
@inject DashboardPreference Cards
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            <SaveCancelClose Dialog="Dialog" Changed="Changed" OnSave="Save" OnReset="PutBackAsync" OnDiscard="PutBackAsync" SaveTitle="Keep the part's settings" />
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <Movable />
        @if (_card is { } card)
        {
            <MudPaper Outlined="true" Class="pa-2">
                <SpanFields Columns="_draft.W" Rows="_draft.H" MaxColumns="card.W" MaxRows="card.H"
                            ColumnsHelp="@($"Cells side by side, up to the card's {card.W}")" RowsHelp="@($"Cells one under the other, up to the card's {card.H}")"
                            Changed="@(size => Change(_draft with { W = size.Columns, H = size.Rows }))" />
                @* The part's type size (the owner, 22 September 2026): one of the
                   theme's four steps up or down from the one the part always had.
                   Never automatic; what no longer fits is cut. *@
                <MudSelect T="TypeSize" Value="_draft.Size" ValueChanged="@(size => Change(_draft with { Size = size }))" Label="Type size" Dense="true" Margin="Margin.Dense" Variant="Variant.Filled" Class="mt-2"
                           HelperText="Medium is the size the part always had; Small a step down, Large a step up" HelperTextOnFocus="true">
                    <MudSelectItem T="TypeSize" Value="TypeSize.Small">Small</MudSelectItem>
                    <MudSelectItem T="TypeSize" Value="TypeSize.Medium">Medium</MudSelectItem>
                    <MudSelectItem T="TypeSize" Value="TypeSize.Large">Large</MudSelectItem>
                </MudSelect>
            </MudPaper>
        }
    </DialogContent>
</MudDialog>

@code {
    /// <summary>The part's settings as they stand on the card now.</summary>
    private sealed record Draft(int W, int H, TypeSize Size);

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired] public string CardId { get; set; } = "";

    /// <summary>The part's key (<see cref="CardPart.Key"/>).</summary>
    [Parameter, EditorRequired] public string PartKey { get; set; } = "";

    /// <summary>The card as it was when the dialog opened: what Cancel and a discarding Close put back.</summary>
    private DashboardCard? _card;
    private Draft _opened = new(1, 1, TypeSize.Medium);
    private Draft _draft = new(1, 1, TypeSize.Medium);

    private bool Changed => _draft != _opened;

    protected override void OnInitialized()
    {
        _card = Cards.Find(CardId);
        if (_card?.Parts?.FirstOrDefault(p => p.Key == PartKey) is { } part)
        {
            _opened = new Draft(part.W, part.H, part.Size);
            _draft = _opened;
        }
    }

    /// <summary>
    /// A field changed: it is applied to the part at once (the owner, 24 September
    /// 2026). The size first, the one the card may refuse: when the cells it
    /// needs are taken the dialog says so and the field stays as the part is.
    /// </summary>
    private async Task Change(Draft draft)
    {
        if ((draft.W, draft.H) != (_draft.W, _draft.H)
            && !await NoRoom.SayIfRefusedAsync(Snackbar, Cards.ResizePartAsync(CardId, PartKey, draft.W, draft.H)))
        {
            Repaint();
            return;
        }

        if (draft.Size != _draft.Size)
        {
            await Cards.SetPartSizeAsync(CardId, PartKey, draft.Size);
        }

        _draft = draft;
        Repaint();
    }

    private void Repaint()
    {
        StateHasChanged();
        Dialog.StateHasChanged();
    }

    /// <summary>The card back as it was when the dialog opened: Cancel, and Close when the changes are let go.</summary>
    private async Task PutBackAsync()
    {
        if (_card is { } opened)
        {
            await NoRoom.SayIfRefusedAsync(Snackbar, Cards.RestoreAsync(opened));
        }

        _draft = _opened;
        Repaint();
    }

    /// <summary>What is on the card is kept, and the dialog closes; the part keeps the focus.</summary>
    private void Save() => Dialog.Close(DialogResult.Ok(true));
}
