@* What a card's reading is made of (the owner, 22 September 2026): a second
   tap on a card that opens nothing else — a reading, a storage card, an
   alarm — asks where its number comes from, and this answers with the figures
   it was worked out from and a line saying how. Close alone in the title row:
   it shows and changes nothing. It opens at one size, the facts scrolling in
   a box of fixed height. *@

<MudDialog>
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            <MudButton Size="Size.Small" Variant="Variant.Filled" OnClick="@(() => Dialog.Cancel())">Close</MudButton>
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <MudPaper Outlined="true" Class="wslc-picker-list pa-2">
            <div class="wslc-summary mb-2">
                @foreach (var fact in Facts)
                {
                    <div><span class="wslc-summary-label">@fact.Label</span><span class="@($"wslc-summary-value{(fact.Mono ? " wslc-mono" : "")}")" title="@fact.Value">@fact.Value</span></div>
                }
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@How</MudText>
        </MudPaper>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The figures the reading was worked out from, label and value.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<InspectFact> Facts { get; set; } = [];

    /// <summary>One line saying how they make the reading, and where they come from.</summary>
    [Parameter, EditorRequired] public string How { get; set; } = "";
}
