@* A dashboard card's settings (docs/home/spec.md, section 5): its size in
   cells — columns and rows — the parts it shows, and its alarms, one per
   measure it can watch. Type sizes belong to the parts, in each part's own
   settings — but a card of one part has its type size here. Each change is
   applied as it is made, so it is seen on the card
   (the owner, 24 September 2026); a size whose cells are taken stays where it
   is and says why. Save keeps what is on the card and closes; Cancel puts the
   card back as it was when the dialog opened; Close asks first when there is
   something to lose, and puts it back too (SaveCancelClose). Reset layout
   puts the card back as its kind ships in this view, size and parts, at once
   as the rest; on a development agent, Save as default makes the card as it
   stands how its kind ships (the agent's card-defaults.json).
   Taking the card off is Edit's − button, not a verb here. The dialog is as
   tall and as wide as its fields, holds nothing of the page under it and is
   moved by its title (DialogFlow.ShowMovableAsync), so what it changes stays
   in sight. It never grows while open: an alarm's threshold is always there,
   greyed while the alarm is off, rather than appearing when it is ticked. *@
@using System.Collections.Immutable
@inject DashboardPreference Cards
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            @* A development agent only: the card as it stands becomes how its
               kind ships, written back to the repository for the installer
               (the owner, 24 September 2026). *@
            @if (Cards.CanSaveDefaults)
            {
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning" OnClick="SaveAsDefaultAsync"
                           title="Make this card's size and layout how every card of its kind ships in this view (development agent)">Save as default</MudButton>
            }
            <MudButton Size="Size.Small" Variant="Variant.Filled" Disabled="@(!CanResetLayout)" OnClick="ResetLayout"
                       title="The card's size and parts back to how its kind ships in this view">Reset layout</MudButton>
            <SaveCancelClose Dialog="Dialog" Changed="Changed" OnSave="Save" OnReset="PutBackAsync" OnDiscard="PutBackAsync" SaveTitle="Keep the card's settings" />
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <Movable />
        @if (_card is { } card)
        {
            <MudPaper Outlined="true" Class="pa-2">
                @* The fields offer the room there is — the dashboard's columns — and
                   enough rows to choose from without dragging; a card already
                   taller than the list keeps its own height in it. *@
                <SpanFields Columns="_draft.W" Rows="_draft.H" MaxColumns="@Math.Max(Cards.Columns, card.W)" MaxRows="@Math.Max(DashboardCatalogue.RowsOffered, card.H)"
                            ColumnsHelp="Cells side by side, as many as the dashboard has"
                            RowsHelp="Cells one under the other; the corner handle goes further"
                            Changed="@(size => Change(_draft with { W = size.Columns, H = size.Rows }))" />
                @* A card of one part — a reading, a counter — has its part's type
                   size here, where the card's Settings are (the owner, 24 September
                   2026: to reach a part's own Settings the card had to be taken and
                   then the part inside it, which on a card of one part nothing
                   shows). A card of several parts sets each in the part's own. *@
                @if (_draft.Size is { } typeSize)
                {
                    <MudSelect T="TypeSize" Value="typeSize" ValueChanged="@(size => Change(_draft with { Size = size }))" Label="Type size" Dense="true" Margin="Margin.Dense" Variant="Variant.Filled" Class="mt-2"
                               HelperText="Medium is the size the card always had; Small a step down, Large a step up" HelperTextOnFocus="true">
                        <MudSelectItem T="TypeSize" Value="TypeSize.Small">Small</MudSelectItem>
                        <MudSelectItem T="TypeSize" Value="TypeSize.Medium">Medium</MudSelectItem>
                        <MudSelectItem T="TypeSize" Value="TypeSize.Large">Large</MudSelectItem>
                    </MudSelect>
                }
                @* Which of the card's parts it shows (the owner, 22 September 2026):
                   a hidden part is not drawn and leaves its cells free; shown
                   again, it takes its place back. *@
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">Shows</MudText>
                <MudStack Spacing="0">
                    @foreach (var key in _partKeys)
                    {
                        var hidden = _draft.Hidden[key];
                        var label = DashboardCatalogue.PartLabel(key);
                        <SquareCheckBox Value="@(!hidden)" ValueChanged="@(shown => Change(_draft with { Hidden = _draft.Hidden.SetItem(key, !shown) }))" Label="@label"
                                        title="@(hidden ? $"Show the {label.ToLowerInvariant()} again" : $"Hide the {label.ToLowerInvariant()}; its cells go free")" />
                    }
                </MudStack>
                @* The card's alarms (the owner, 22 September 2026), one per measure it
                   can watch: past its threshold the card turns red and blinks. A
                   system or alarm card watches its one measure, on until switched
                   off; a container's card its CPU and its memory, each on its own,
                   off until switched on — both at once when both are. *@
                @if (_draft.Alarms.Count > 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">Alarm</MudText>
                    @foreach (var alarm in DashboardCatalogue.Measures(card.Card).Select(measure => _draft.Alarms[measure]))
                    {
                        var label = DashboardCatalogue.MeasureLabel(alarm.Measure);
                        @* The box and its threshold on one line (the owner, 22 September 2026). *@
                        <div class="wslc-field-row wslc-field-row-boxed">
                            <SquareCheckBox Value="@(!alarm.Off)" ValueChanged="@(on => Change(_draft with { Alarms = _draft.Alarms.SetItem(alarm.Measure, alarm with { Off = !on }) }))"
                                            Label="@label"
                                            title="@(alarm.Off ? $"Turn the card red when its {label.ToLowerInvariant()} passes the threshold" : $"The card stays as it is whatever its {label.ToLowerInvariant()}")" />
                            <MudSelect T="int" Value="alarm.Threshold" ValueChanged="@(value => Change(_draft with { Alarms = _draft.Alarms.SetItem(alarm.Measure, alarm with { Threshold = value }) }))"
                                       Label="Threshold" Dense="true" Margin="Margin.Dense" Variant="Variant.Filled" Disabled="alarm.Off"
                                       HelperText="@($"Past this percent of {label.ToLowerInvariant()} the card turns red and blinks")" HelperTextOnFocus="true">
                                @for (var percent = 5; percent <= 100; percent += 5)
                                {
                                    var value = percent;
                                    <MudSelectItem T="int" Value="value">@($"{value}%")</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    }
                }
            </MudPaper>
        }
    </DialogContent>
</MudDialog>

@code {
    /// <summary>
    /// The settings as they stand on the card now: the size, whether each part
    /// is hidden, the alarms by measure, whether the layout went back to the
    /// card's own, and the type size of its part when it has only one (null
    /// when it has several, each set in its own Settings).
    /// </summary>
    private sealed record Draft(int W, int H, ImmutableDictionary<string, bool> Hidden, ImmutableDictionary<string, CardAlarm> Alarms, bool ResetLayout, TypeSize? Size)
    {
        public bool SameAs(Draft other) =>
            W == other.W && H == other.H && ResetLayout == other.ResetLayout && Size == other.Size && Same(Hidden, other.Hidden) && Same(Alarms, other.Alarms);

        private static bool Same<T>(ImmutableDictionary<string, T> a, ImmutableDictionary<string, T> b) =>
            a.Count == b.Count && a.All(pair => b.TryGetValue(pair.Key, out var value) && Equals(value, pair.Value));
    }

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    /// <summary>The card's own id (<see cref="DashboardCard.Id"/>).</summary>
    [Parameter, EditorRequired] public string CardId { get; set; } = "";

    /// <summary>The card as it was when the dialog opened: what Cancel and a discarding Close put back.</summary>
    private DashboardCard? _card;

    /// <summary>The card's parts in the card's own order, for Shows.</summary>
    private IReadOnlyList<string> _partKeys = [];
    private Draft _opened = default!;
    private Draft _draft = default!;

    private bool Changed => !_draft.SameAs(_opened);

    /// <summary>The card's parts stand where the user put them, and Reset layout has not been asked for yet.</summary>
    private bool CanResetLayout => !_draft.ResetLayout && (Cards.Find(CardId)?.Parts is not null || (_draft.W, _draft.H) != ShippedSize);

    protected override void OnInitialized()
    {
        _card = Cards.Find(CardId);
        if (_card is { } card)
        {
            _partKeys = [.. Cards.PartsOf(card).Select(part => part.Key)];
            _opened = DraftOf(card, resetLayout: false);
            _draft = _opened;
        }
    }

    private Draft DraftOf(DashboardCard card, bool resetLayout)
    {
        var parts = Cards.PartsOf(resetLayout ? card with { Parts = null } : card);
        return new(
            card.W,
            card.H,
            parts.ToImmutableDictionary(part => part.Key, part => part.Hidden),
            DashboardCatalogue.Measures(card.Card).ToImmutableDictionary(measure => measure, measure => DashboardCatalogue.AlarmSetting(card, measure)),
            resetLayout,
            parts is [var only] ? only.Size : null);
    }

    /// <summary>
    /// A field changed: it is applied to the card at once (the owner,
    /// 24 September 2026). The size first, since it is the one the dashboard
    /// may refuse: when the cells it needs are taken the dialog says so and the
    /// fields stay as the card is. Then the layout, the parts shown and the
    /// alarms, each only where it differs from what the card has now.
    /// </summary>
    private async Task Change(Draft draft)
    {
        if ((draft.W, draft.H) != (_draft.W, _draft.H)
            && !await NoRoom.SayIfRefusedAsync(Snackbar, Cards.ResizeAsync(CardId, draft.W, draft.H)))
        {
            Repaint();
            return;
        }

        if (draft.ResetLayout && !_draft.ResetLayout)
        {
            await Cards.ResetLayoutAsync(CardId);
        }

        foreach (var (key, hidden) in draft.Hidden)
        {
            if (Cards.Find(CardId) is { } card && Cards.PartsOf(card).FirstOrDefault(part => part.Key == key) is { } part && part.Hidden != hidden)
            {
                await Cards.SetPartShownAsync(CardId, key, !hidden);
            }
        }

        foreach (var alarm in draft.Alarms.Values.Where(alarm => !Equals(alarm, _draft.Alarms[alarm.Measure])))
        {
            await Cards.SetAlarmAsync(CardId, alarm);
        }

        if (draft.Size is { } size && size != _draft.Size && _partKeys is [var only])
        {
            await Cards.SetPartSizeAsync(CardId, only, size);
        }

        _draft = draft;
        Repaint();
    }

    private void Repaint()
    {
        StateHasChanged();
        Dialog.StateHasChanged();
    }

    /// <summary>
    /// The card as its kind ships in this view (the owner, 24 September 2026):
    /// its size and its parts' layout, at once; the alarms as they are. A kind
    /// that ships no size keeps the card's.
    /// </summary>
    private Task ResetLayout()
    {
        var (w, h) = ShippedSize;
        return Change(DraftOf(Cards.Find(CardId) ?? _card!, resetLayout: true) with { W = w, H = h, Alarms = _draft.Alarms });
    }

    /// <summary>The size the card's kind ships at in this view, or the card's own when it ships none.</summary>
    private (int W, int H) ShippedSize => _card is { } card && Cards.DefaultSize(card.Card) is { } shipped ? shipped : (_draft.W, _draft.H);

    /// <summary>
    /// The card as it stands made how its kind ships in this view, written back
    /// to the repository by the development agent (the owner, 24 September
    /// 2026), so the next installer ships it.
    /// </summary>
    private async Task SaveAsDefaultAsync()
    {
        var name = DashboardCatalogue.Find(_card?.Card ?? "")?.Label ?? "this kind";
        if (await Cards.SaveAsDefaultAsync(CardId))
        {
            // The view named: which one a save went to is not seen on the card.
            Snackbar.Add($"Saved as how every {name} card ships in the {(Cards.View == DashboardView.Mobile ? "mobile" : "desktop")} view.", Severity.Success);
        }
        else
        {
            Snackbar.Add("The agent did not save it: only a development agent writes the cards' defaults.", Severity.Warning);
        }
    }

    /// <summary>The card back as it was when the dialog opened: Cancel, and Close when the changes are let go.</summary>
    private async Task PutBackAsync()
    {
        if (_card is { } opened)
        {
            await NoRoom.SayIfRefusedAsync(Snackbar, Cards.RestoreAsync(opened));
        }

        _draft = _opened;
        Repaint();
    }

    /// <summary>What is on the card is kept, and the dialog closes.</summary>
    private void Save() => Dialog.Close(DialogResult.Ok(true));
}
