@* The list Edit's + button opens (docs/home/spec.md, section 5), with a
   selector of what it lists (the owner, 22 September 2026):

   - System: the standard cards, readings of the whole host, each with a box
     ticked while the dashboard shows it, the All box above them ticking or
     unticking the lot (the dash while only some are ticked).
   - Containers, Images, Volumes, Networks: the resources there are now, read
     when the selector is set to them, so one created a minute ago is there;
     a box ticked while the dashboard has its card, by its number in the
     agent's registry. This list is the one way a resource reaches the
     dashboard (the owner, 22 September 2026).

   The boxes apply nothing until Save (the owner, 22 September 2026), which
   puts the dashboard as they say, in one save, and closes; Cancel and Close
   are SaveCancelClose's. The list opens with no Escape
   (DialogFlow.ShowPersistentAsync), so no key throws away what was ticked,
   and at one size: the boxes scroll in a box of fixed height
   (wslc-picker-list), whatever the family chosen holds. *@
@inject DashboardPreference Cards
@inject WslcAgentApi Api

<MudDialog>
    <TitleContent>
        <DialogTitle Title="@Dialog.Title">
            <SaveCancelClose Dialog="Dialog" Changed="Changed" OnSave="SaveAsync" OnReset="ResetAsync" SaveTitle="Put the dashboard as the boxes say" />
        </DialogTitle>
    </TitleContent>
    <DialogContent>
        <MudSelect T="string" Value="_family" ValueChanged="ChooseAsync" Label="Cards of" Dense="true" Margin="Margin.Dense" Variant="Variant.Filled"
                   HelperText="System cards read the whole host; the others show one of your resources" HelperTextOnFocus="true">
            <MudSelectItem T="string" Value="System">System</MudSelectItem>
            <MudSelectItem T="string" Value="AlarmsFamily">Alarms</MudSelectItem>
            @foreach (var kind in DashboardCatalogue.Resources)
            {
                <MudSelectItem T="string" Value="kind.Key">@Plural(kind)</MudSelectItem>
            }
        </MudSelect>
        <MudPaper Outlined="true" Class="wslc-picker-list pa-2 mt-2">
            @if (_family == System)
            {
                <SquareCheckBox Value="All" Partly="Some" ValueChanged="TickAll" Label="All"
                                title="@(All ? "Untick every system card" : "Tick every system card")" />
                <MudDivider Class="my-1" />
                @foreach (var kind in DashboardCatalogue.All)
                {
                    var ticked = _kinds.Contains(kind.Key);
                    @* A card that is always there is ticked and cannot be unticked. *@
                    <SquareCheckBox Value="@(ticked || kind.IsFixed)" ValueChanged="@(on => Tick(kind.Key, on))" Label="@kind.Label" Disabled="kind.IsFixed"
                                    title="@(kind.IsFixed ? $"{kind.Label} is always on the dashboard" : ticked ? $"Take {kind.Label} off the dashboard on Save" : $"Add {kind.Label} to the dashboard on Save")" />
                }
            }
            else if (_family == AlarmsFamily)
            {
                @foreach (var kind in DashboardCatalogue.Alarms)
                {
                    var ticked = _kinds.Contains(kind.Key);
                    <SquareCheckBox Value="ticked" ValueChanged="@(on => Tick(kind.Key, on))" Label="@kind.Label"
                                    title="@(ticked ? $"Take {kind.Label} off the dashboard on Save" : $"Add {kind.Label} to the dashboard on Save")" />
                }
            }
            else if (_loading)
            {
                <MudProgressLinear Indeterminate="true" />
            }
            else if (_resources.Failed(_family))
            {
                <MudText Typo="Typo.caption" Class="mud-error-text">The @Word could not be read. @_resources.Error(_family)</MudText>
            }
            else
            {
                var rows = _resources.Rows(_family);
                @foreach (var row in rows)
                {
                    var ticked = _picked.ContainsKey(row.Uid);
                    <SquareCheckBox Value="ticked" ValueChanged="@(on => Tick(row.Uid, on))" Label="@(row.Note.Length > 0 ? $"{row.Name} · {row.Note}" : row.Name)"
                                    title="@(ticked ? $"Take {row.Name} off the dashboard on Save" : $"Put {row.Name} on the dashboard on Save")" />
                }
                @if (rows.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">There are no @Word in this session.</MudText>
                }
            }
        </MudPaper>
    </DialogContent>
</MudDialog>

@code {
    /// <summary>The selector's value for the standard cards; a family of resources is its kind's key.</summary>
    private const string System = "";

    /// <summary>The selector's value for the alarm cards (the owner, 22 September 2026).</summary>
    private const string AlarmsFamily = "alarms";

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;

    private string _family = System;
    private DashboardResources _resources = default!;
    private bool _loading;

    /// <summary>What the dashboard showed when the list opened: what Cancel goes back to, and what Save is measured against.</summary>
    private IReadOnlySet<string> _openedKinds = new HashSet<string>();

    private IReadOnlyDictionary<int, string> _openedResources = new Dictionary<int, string>();

    /// <summary>The boxes as they are ticked now: the standard kinds, and the resources by their uid with the kind of card each takes.</summary>
    private HashSet<string> _kinds = [];

    private Dictionary<int, string> _picked = [];

    private bool All => DashboardCatalogue.All.All(kind => _kinds.Contains(kind.Key));

    private bool Some => !All && DashboardCatalogue.All.Any(kind => _kinds.Contains(kind.Key));

    /// <summary>A box differs from the dashboard: there is something to save, or to cancel.</summary>
    private bool Changed =>
        !_kinds.SetEquals(_openedKinds)
        || _picked.Count != _openedResources.Count
        || _picked.Any(pick => !_openedResources.ContainsKey(pick.Key));

    /// <summary>The chosen family as a sentence names it: "containers", "images".</summary>
    private string Word => DashboardCatalogue.Find(_family) is { } kind ? Plural(kind).ToLowerInvariant() : "";

    private static string Plural(CardKind kind) => $"{kind.Label}s";

    protected override void OnInitialized()
    {
        _resources = new DashboardResources(Api);
        _openedKinds = DashboardCatalogue.Standard.Where(kind => Cards.IsShown(kind.Key)).Select(kind => kind.Key).ToHashSet();
        _openedResources = new Dictionary<int, string>(Cards.Resources);
        Reset();
    }

    /// <summary>The boxes as the dashboard is.</summary>
    private void Reset()
    {
        _kinds = [.. _openedKinds];
        _picked = new Dictionary<int, string>(_openedResources);
    }

    /// <summary>The family chosen; a family of resources is read now, so what was created a moment ago is in it.</summary>
    private async Task ChooseAsync(string family)
    {
        _family = family;
        if (family is System or AlarmsFamily)
        {
            return;
        }

        _loading = true;
        StateHasChanged();
        try
        {
            await _resources.RefreshAsync(family);
        }
        finally
        {
            _loading = false;
        }
    }

    private void Tick(string kind, bool on)
    {
        if (on)
        {
            _kinds.Add(kind);
        }
        else
        {
            _kinds.Remove(kind);
        }

        Repaint();
    }

    private void Tick(int uid, bool on)
    {
        if (on)
        {
            _picked[uid] = _family;
        }
        else
        {
            _picked.Remove(uid);
        }

        Repaint();
    }

    /// <summary>The All box of System: every system card on or off, the alarm cards left as they are, a card that is always there kept.</summary>
    private void TickAll(bool on)
    {
        foreach (var kind in DashboardCatalogue.All)
        {
            if (on || kind.IsFixed)
            {
                _kinds.Add(kind.Key);
            }
            else
            {
                _kinds.Remove(kind.Key);
            }
        }

        Repaint();
    }

    /// <summary>The boxes and the title row's verbs, which MudBlazor draws in a tree of its own and repaints only when told (docs/ui-controls.md, Dialogs).</summary>
    private void Repaint()
    {
        StateHasChanged();
        Dialog.StateHasChanged();
    }

    private async Task SaveAsync()
    {
        await Cards.ShowOnlyAsync(_kinds, _picked);
        Dialog.Close(DialogResult.Ok(true));
    }

    private Task ResetAsync()
    {
        Reset();
        Repaint();
        return Task.CompletedTask;
    }
}
