@* A size in cells, columns and rows, each a select from one to its limit:
   the card's own size in its settings, a part's inside its card. One pair of
   fields for both, so they read the same, side by side on one line (the
   owner, 22 September 2026: one under the other left the dialog half
   empty). *@

<div class="wslc-field-row">
    <MudSelect T="int" Value="Columns" ValueChanged="@(w => Changed.InvokeAsync((w, Rows)))" Label="Columns" Dense="true" Margin="Margin.Dense" Variant="Variant.Filled"
               HelperText="@ColumnsHelp" HelperTextOnFocus="true">
        @for (var n = 1; n <= MaxColumns; n++)
        {
            var columns = n;
            <MudSelectItem T="int" Value="@columns">@columns</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="int" Value="Rows" ValueChanged="@(h => Changed.InvokeAsync((Columns, h)))" Label="Rows" Dense="true" Margin="Margin.Dense" Variant="Variant.Filled"
               HelperText="@RowsHelp" HelperTextOnFocus="true">
        @for (var n = 1; n <= MaxRows; n++)
        {
            var rows = n;
            <MudSelectItem T="int" Value="@rows">@rows</MudSelectItem>
        }
    </MudSelect>
</div>

@code {
    [Parameter, EditorRequired] public int Columns { get; set; }

    [Parameter, EditorRequired] public int Rows { get; set; }

    [Parameter, EditorRequired] public int MaxColumns { get; set; }

    [Parameter, EditorRequired] public int MaxRows { get; set; }

    [Parameter] public string ColumnsHelp { get; set; } = "";

    [Parameter] public string RowsHelp { get; set; } = "";

    /// <summary>The size asked for, columns and rows.</summary>
    [Parameter] public EventCallback<(int Columns, int Rows)> Changed { get; set; }
}
