@* The System card (the owner, 24 September 2026): the system at a glance,
   every reading a part of its own that the user moves, sizes, hides and sets
   the type size of (DashboardCatalogue.SystemPieces, where more are added).
   Always on the dashboard (CardKind.IsFixed). The header is the session every
   command targets and whether it runs, and the session is a part too, the
   title bar's own line with its selector and its verbs. The readings are the versions — the
   native client's, green or amber with its install, which no longer sits
   beside the brand where it pushed a phone's title bar off the screen; the
   agent's; wslc's, Windows' and the kernel's — whether the agent is hearing
   wslc's events or the screens read on their own clock, and the load of the
   host as three rings, and the native client's update or, in a browser, its
   download, which left the title bar too. No footer: a tap anywhere on the
   card opens the System page.

   Nothing here polls: the versions are read once, the rings are the readings
   Home already takes for its cards and alarms (AlarmReadings), and the event
   stream's state is read again when the agent says the session changed. *@
@implements IDisposable
@inject WslcAgentApi Api
@inject SessionState Session
@inject AlarmReadings Watch
@inject AgentChanges Changes

<HomeCard Label="System" Frame="Frame" Value="@Session.Selected" Hint="@SessionWord" Pieces="Piece">
    <Header>
        <EntityCardPart>
            @* No state chip: the avatar's colour says it, green running, red
               stopped (the owner, 24 September 2026: "active" read as nothing). *@
            <EntityCardHeader Title="System" Subtitle="@Session.Selected" AvatarColor="@(Session.Active ? Color.Success : Color.Error)" Key="system" />
        </EntityCardPart>
    </Header>
</HomeCard>

@code {
    private HealthResponse? _agent;
    private SystemOverview? _system;
    private bool? _live;

    [Parameter, EditorRequired] public HomeCard.CardFrame Frame { get; set; } = default!;

    /// <summary>The card on the dashboard, which the rings read their host measures through.</summary>
    [Parameter, EditorRequired] public DashboardCard Card { get; set; } = default!;

    private string SessionWord => Session.Active ? "Active" : "Stopped";

    /// <summary>
    /// What each reading draws, a part of its own (DashboardCatalogue.SystemPieces):
    /// a text as a label over its value, the load as a ring. A key this does
    /// not know draws nothing.
    /// </summary>
    private RenderFragment? Piece(string key) => key switch
    {
        // The title bar's own session line, here too (the owner, 24 September
        // 2026): the selector, refresh and the power button, one component
        // over one SessionPower, so the two always agree. Its taps are its own.
        DashboardCatalogue.SystemSession => Reading("Session", @<VerbTaps><SessionPanel /></VerbTaps>, "wslc-system-session"),
        DashboardCatalogue.SystemClient => Reading("Client", @<VerbTaps><ClientVersionLink /></VerbTaps>),
        DashboardCatalogue.SystemAgent => Text("Agent", _agent is null ? "…" : $"{_agent.Version} · {(_agent.Development ? "dev" : "prod")}"),
        DashboardCatalogue.SystemWslc => Text("wslc", _system is null ? "…" : Readings.Dash(_system.Info.ClientVersion)),
        DashboardCatalogue.SystemWindows => Text("Windows", _system is null ? "…" : Readings.Dash(_system.Info.Windows)),
        DashboardCatalogue.SystemKernel => Text("Kernel", _system is null ? "…" : Readings.Dash(_system.Info.Kernel)),
        DashboardCatalogue.SystemEvents => Text("Events", _live switch { true => "live", false => "screens poll", null => "…" }),
        DashboardCatalogue.SystemCpu => Ring(DashboardCatalogue.CpuMeasure),
        DashboardCatalogue.SystemMemory => Ring(DashboardCatalogue.MemoryMeasure),
        DashboardCatalogue.SystemDisk => Ring(DashboardCatalogue.DiskMeasure),
        DashboardCatalogue.SystemClientPackage => ClientPackage,
        _ => null,
    };

    /// <summary>
    /// The native client, as a part of its own (the owner, 24 September 2026:
    /// a footer for one button was a row wasted): in a browser the download
    /// of the client for this device; in the client itself its update, amber
    /// when there is one to install. Tapping the card anywhere else opens the
    /// System page.
    /// </summary>
    private static RenderFragment ClientPackage => @<div class="wslc-system-ring"><ClientPackageButtons /></div>;

    private static RenderFragment Text(string label, string value) =>
        @<SummaryReading Label="@label" Value="@value" />;

    /// <summary>
    /// A label over what it names, in the summary's tone; the type steps of its
    /// part apply to both (the stylesheet). <paramref name="arrangement"/> is a
    /// reading laid out otherwise, as the session's grid.
    /// </summary>
    private static RenderFragment Reading(string label, RenderFragment value, string arrangement = "") =>
        @<SummaryReading Label="@label" Class="@arrangement">@value</SummaryReading>;

    /// <summary>One of the host's measures as a ring, the readings Home already takes (AlarmReadings).</summary>
    private RenderFragment Ring(string measure)
    {
        var value = Watch.MeasureOf(Card, measure);
        return @<div class="wslc-system-ring">
            <UsageDial Label="@DashboardCatalogue.MeasureShort(measure)" Reading="@(value is { } v ? Percents.Text(v) : "")" Live="@(value is not null)"
                       Size="Size.Large" Title="@($"{DashboardCatalogue.MeasureLabel(measure)} {(value is { } shown ? Percents.Text(shown) : "not known yet")}")" />
        </div>;
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnChanged;
        Watch.Changed += OnChanged;
        Changes.Changed += OnAgentChanged;
        await Task.WhenAll(ReadAgentAsync(), ReadSystemAsync(), ReadEventsAsync());
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Watch.Changed -= OnChanged;
        Changes.Changed -= OnAgentChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>The event stream lives and dies with the session: when the agent says the session changed, its state is read again.</summary>
    private void OnAgentChanged(ChangeNotice notice)
    {
        if (notice.Touches(ChangeNotice.Session))
        {
            _ = InvokeAsync(async () =>
            {
                await ReadEventsAsync();
                StateHasChanged();
            });
        }
    }

    private async Task ReadAgentAsync()
    {
        try
        {
            _agent = await Api.GetHealthAsync();
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            // The line keeps saying it is not known; the layout speaks for an agent that is gone.
        }
    }

    /// <summary>wslc's version, Windows and the kernel, from the System page's own reading, which opens no session.</summary>
    private async Task ReadSystemAsync()
    {
        try
        {
            _system = await Api.GetSystemAsync();
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            // Not known: the lines say so.
        }
    }

    private async Task ReadEventsAsync()
    {
        try
        {
            _live = (await Api.GetEventStatusAsync()).Live;
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            _live = null;
        }
    }
}
