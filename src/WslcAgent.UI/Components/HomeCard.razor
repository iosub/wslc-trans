@* One of the dashboard's cards: a grid of its own cells, its parts on them
   — the summary (a label, the value, the hint under it) on every card, a
   sparkline and its legend on a chart card, the session stores' bars — each
   at its defined size until the user lays it out (the owner, 22 September
   2026: nothing adjusts itself; a part given fewer cells cuts what no longer
   fits, and a part the card has no room for waits below its last row).

   The focus (the owner, 22 September 2026). A tap selects the card: it
   wears the green everything selected wears, and in Edit its parts are
   squared off in a fainter green to say what can be taken. The card has
   the focus then: the hand anywhere on it, parts included, moves the whole
   card, and the handle at its corner resizes it. A tap on a part of the
   selected card gives that part the focus: it wears the green, the hand
   moves it, the handle at its corner resizes it, and a tap on the card's
   floor gives the focus back to the card. The parts move with the same
   engine as the cards (wslcAgent.dashboardGrid on the card's grid). In View
   the round button offers Open; a second tap on the selected card opens
   it. With Smaller type on (Settings), the value and the legend step down
   one of the theme's sizes. A card whose probe failed is bordered in the
   error colour. *@
@implements IAsyncDisposable
@inject IJSRuntime Js

<MudPaper Outlined="true" Class="@Classes" title="@Tip">
    @* The tap lives on an element of its own: a component takes no event
       modifier, and the tap must not reach the page around the cards, whose
       own tap lets the selection go. *@
    <div class="wslc-home-card-tap" role="button" aria-pressed="@(Frame.Selected ? "true" : "false")" aria-label="@($"{Label}: select")"
         @onclick="@(() => Frame.Select(Frame.Id))" @onclick:stopPropagation="true">
        @* As many cells as the card spans, each part on its cells: its place on
           its box, as a card's is on the dashboard. *@
        <div class="@GridClasses" @ref="_partsGrid"
             style="@($"grid-template-columns: repeat({Frame.Columns}, 1fr); grid-template-rows: repeat({Frame.Rows}, 1fr)")"
             data-max-columns="@Frame.Columns" data-max-rows="@Frame.Rows">
            @foreach (var part in Frame.Parts.Where(p => !p.Hidden))
            {
                var focused = part.Key == Frame.SelectedPart;
                <div class="@(focused ? "wslc-dash-item wslc-card-part wslc-card-part-selected" : "wslc-dash-item wslc-card-part")" @key="part.Key"
                     style="@($"grid-area: {part.Y + 1} / {part.X + 1} / span {part.H} / span {part.W}")"
                     data-id="@part.Key" data-x="@part.X" data-y="@part.Y" data-w="@part.W" data-h="@part.H"
                     @onclick="@(() => TapPartAsync(part.Key))" @onclick:stopPropagation="true">
                    @Part(part)
                    @if (focused)
                    {
                        @Gear
                        <div class="wslc-home-card-handle" @ref="_partHandle" title="Drag to resize" aria-hidden="true"
                             @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
                            <MudIcon Icon="@Icons.Material.Filled.SouthEast" Size="Size.Small" />
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    @if (Loading)
    {
        @* Its reading on its way (the owner, 22 September 2026): the progress
           of anything in this view is a ring, in the middle of what waits for
           it, and it takes no touch, so the card can still be taken. *@
        <div class="wslc-home-card-loading" role="progressbar" aria-label="@($"{Label}: loading")">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    @if (CardHasFocus)
    {
        @Gear
        <div class="wslc-home-card-handle" @ref="_handle" title="Drag to resize" aria-hidden="true"
             @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
            <MudIcon Icon="@Icons.Material.Filled.SouthEast" Size="Size.Small" />
        </div>
    }
</MudPaper>

@code {
    /// <summary>
    /// What the dashboard tells every card about itself: its id and cells,
    /// whether it is selected, whether the dashboard is in Edit, how its parts
    /// stand and which of them has the focus, and what a tap, a drag and a
    /// resize do.
    /// </summary>
    /// <param name="Parts">The parts on the card's cells, defined or laid out, each with its type size (DashboardPreference.PartsOf).</param>
    /// <param name="SelectedPart">The part that has the focus in the selected card, if one has.</param>
    /// <param name="Alarm">The card's alarm is up: its measure is past its threshold, and the card turns red and blinks (the owner, 22 September 2026).</param>
    public sealed record CardFrame(
        string Id,
        int Columns,
        int Rows,
        bool Selected,
        bool Editing,
        IReadOnlyList<CardPart> Parts,
        string? SelectedPart,
        Func<string, Task> Select,
        Func<string, int, int, Task> Resize,
        Func<string, string, Task> SelectPart,
        Func<string, string, int, int, Task> MovePart,
        Func<string, string, int, int, Task> ResizePart,
        bool Alarm = false,
        Func<Task>? Settings = null);

    /// <summary>
    /// The settings of what has the focus, one tap away (the owner, 24 September
    /// 2026): a gear in the corner across from the resize handle, on the
    /// selected card or on its taken part, which opens that one's Settings.
    /// Its taps and presses stop here, so the grid neither selects nor drags.
    /// </summary>
    private RenderFragment? Gear => Frame.Settings is not { } settings ? null :
        @<div class="wslc-home-card-gear" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Color="Color.Success" OnClick="settings"
                           title="Settings" aria-label="Settings" />
        </div>;

    private ElementReference _handle;
    private ElementReference _partHandle;
    private ElementReference _partsGrid;
    private DotNetObjectReference<HomeCard>? _self;
    private IJSObjectReference? _partsJs;
    private readonly SemaphoreSlim _wiring = new(1, 1);
    private bool _wired;
    private string? _partWiredFor;

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Value { get; set; } = "";

    [Parameter] public string Hint { get; set; } = "";

    [Parameter] public bool Error { get; set; }

    /// <summary>What the card shows is still on its way: a ring turns over it until it arrives, or fails.</summary>
    [Parameter] public bool Loading { get; set; }

    [Parameter, EditorRequired] public CardFrame Frame { get; set; } = default!;

    /// <summary>What the card carries besides its summary: a sparkline, the session stores' bars.</summary>
    [Parameter] public RenderFragment? Body { get; set; }

    /// <summary>A chart's legend, a part of its own.</summary>
    [Parameter] public RenderFragment? Legend { get; set; }

    /// <summary>
    /// For a card whose body is many parts rather than one (the System card's
    /// readings, the owner, 24 September 2026): what each part draws, by its
    /// key; a key it answers null for draws the <see cref="Body"/>.
    /// </summary>
    [Parameter] public Func<string, RenderFragment?>? Pieces { get; set; }

    /// <summary>A resource card's summary: the list card's own header (EntityCardHeader), drawn instead of the three texts a reading shows.</summary>
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>
    /// A resource card's verbs, a part of their own. The row of buttons is
    /// wrapped in <see cref="VerbTaps"/> by whoever hands it over, so a tap on
    /// one runs it and does not select the card.
    /// </summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>In Edit and selected, with no part taken: the hand and the handle are the card's.</summary>
    private bool CardHasFocus => Frame.Editing && Frame.Selected && Frame.SelectedPart is null;

    /// <summary>In Edit and selected, with a part taken: the hand and the handle are the part's.</summary>
    private bool PartHasFocus => Frame.Editing && Frame.Selected && Frame.SelectedPart is not null;

    private string Classes =>
        // pa-1, not pa-3 (the owner, 22 September 2026): twelve points a side
        // ate the cells the parts stand in.
        $"wslc-home-card pa-1{(Frame.Selected ? " wslc-home-card-selected" : "")}{(Error ? " wslc-home-card-error" : "")}{(Frame.Alarm ? " wslc-home-card-alarm" : "")}";

    /// <summary>The parts squared off in a fainter green once the card is selected in Edit; answering to the hand once one of them has the focus.</summary>
    private string GridClasses =>
        PartHasFocus ? "wslc-card-grid wslc-card-grid-marked wslc-dash-editing"
        : Frame.Editing && Frame.Selected ? "wslc-card-grid wslc-card-grid-marked"
        : "wslc-card-grid";

    private string Tip => (Frame.Editing, Frame.Selected, Frame.SelectedPart is not null) switch
    {
        (true, true, true) => "Drag the part to move it, drag its corner to resize it; tap the card's floor to take the whole card again",
        (true, true, false) => "Drag to move the card; drag the corner to resize it; tap a part to take it instead",
        (true, false, _) => "Drag to move it; tap to select it",
        (false, true, _) => "Tap again to open it; its verbs are in the round button",
        _ => "Tap to select it; its verbs open in the round button",
    };

    /// <summary>A tap on a part: in Edit, once the card is selected, it takes the part; otherwise it is a tap on the card.</summary>
    private Task TapPartAsync(string key) =>
        Frame.Editing && Frame.Selected ? Frame.SelectPart(Frame.Id, key) : Frame.Select(Frame.Id);

    /// <summary>The three texts, stacked, each line cut at the part's edge; the part's type size steps them by a class the stylesheet reads.</summary>
    private RenderFragment Summary => @<ReadingSummary Label="@Label" Value="@Value" Hint="@Hint" Error="Error" />;

    /// <summary>What a part shows, in a box that carries the part's kind and type size for the stylesheet.</summary>
    private RenderFragment? Part(CardPart part) => part.Key switch
    {
        DashboardCatalogue.Summary => Sized(Header ?? Summary, part),
        DashboardCatalogue.Legend => Sized(Legend, part),
        DashboardCatalogue.Actions => Sized(Verbs, part),
        _ => Sized(Pieces?.Invoke(part.Key) ?? Body, part),
    };

    /// <summary>
    /// The verbs' part fills its cells, so the footer's tone covers it as the
    /// header's covers its own. The buttons keep their taps through
    /// <see cref="VerbTaps"/> in View, and are inert in Edit, where the part
    /// answers to the hand that arranges it.
    /// </summary>
    private RenderFragment? Verbs => Actions is null ? null : @<div class="wslc-card-part-verbs">@Actions</div>;

    private static RenderFragment? Sized(RenderFragment? content, CardPart part) =>
        content is null ? null : @<div class="@($"wslc-card-part-body wslc-card-part-{part.Key} wslc-type-{part.Size.ToString().ToLowerInvariant()}")">@content</div>;

    /// <summary>
    /// The card's handle exists only while the card has the focus, the parts'
    /// drag and the taken part's handle only while a part has it: each is
    /// wired each time it appears, and the grid's helper let go when the focus
    /// leaves the parts.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _self ??= DotNetObjectReference.Create(this);
        // One wiring at a time: renders come in bursts while the hand resizes,
        // and a second pass that ran while the first awaited the browser found
        // the parts' helper the first had just let go (the owner, 22 September
        // 2026: a NullReferenceException on the phone and the emulator).
        await _wiring.WaitAsync();
        try
        {
            await WireCardHandleAsync();
            await WirePartsAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // The card left while this was in flight.
        }
        finally
        {
            _wiring.Release();
        }
    }

    private async Task WireCardHandleAsync()
    {
        if (!CardHasFocus)
        {
            _wired = false;
            return;
        }

        if (!_wired)
        {
            _wired = true;
            await Js.InvokeVoidAsync("wslcAgent.dashboardResize", _handle, _self, "ResizedAsync");
        }
    }

    private async Task WirePartsAsync()
    {
        if (!PartHasFocus)
        {
            _partWiredFor = null;
            if (_partsJs is { } parts)
            {
                _partsJs = null;
                await parts.InvokeVoidAsync("dispose");
                await parts.DisposeAsync();
            }

            return;
        }

        _partsJs ??= await Js.InvokeAsync<IJSObjectReference>("wslcAgent.dashboardGrid", _partsGrid, _self);
        if (_partWiredFor != Frame.SelectedPart)
        {
            _partWiredFor = Frame.SelectedPart;
            await Js.InvokeVoidAsync("wslcAgent.dashboardResize", _partHandle, _self, "PartResizedAsync");
        }
    }

    /// <summary>The card's handle was let go: the cells the card was dragged to.</summary>
    [JSInvokable]
    public Task ResizedAsync(int columns, int rows) => Frame.Resize(Frame.Id, columns, rows);

    /// <summary>The taken part's handle was let go.</summary>
    [JSInvokable]
    public Task PartResizedAsync(int columns, int rows) =>
        Frame.SelectedPart is null ? Task.CompletedTask : Frame.ResizePart(Frame.Id, Frame.SelectedPart, columns, rows);

    /// <summary>A part was let go over a cell of the card.</summary>
    [JSInvokable]
    public Task MovedAsync(string key, int x, int y) => Frame.MovePart(Frame.Id, key, x, y);

    /// <summary>The card's grid has as many columns as the card, in either view: nothing to learn from measuring it.</summary>
    [JSInvokable]
    public Task ColumnsChangedAsync(int columns, bool mobile) => Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_partsJs is { } parts)
            {
                _partsJs = null;
                await parts.InvokeVoidAsync("dispose");
                await parts.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // The page is going away.
        }

        _self?.Dispose();
    }
}
