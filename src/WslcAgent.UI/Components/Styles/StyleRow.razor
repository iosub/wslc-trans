@* One row of the Styles page: the control at the left, rendered with the
   values chosen at the right, where every style property the control takes
   is an editor. `Fixed` says which values the application itself uses. *@
@if (!Hidden)
{
    <section class="wslc-style-row">
        <div class="wslc-style-control">
            <MudText Typo="Typo.subtitle2">@Title</MudText>
            @if (Fixed.Length > 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary wslc-style-fixed">@Fixed</MudText>
            }
            <div class="wslc-style-sample">
                @Control
            </div>
        </div>
        <div class="wslc-style-props">
            @Properties
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>The values the application fixes for this control (from docs/ui-controls.md).</summary>
    [Parameter] public string Fixed { get; set; } = "";

    [Parameter, EditorRequired] public RenderFragment Control { get; set; } = default!;

    [Parameter] public RenderFragment? Properties { get; set; }

    /// <summary>True when the page's search does not match this row.</summary>
    [Parameter] public bool Hidden { get; set; }
}
