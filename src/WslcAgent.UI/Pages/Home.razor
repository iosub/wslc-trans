@* Today's Home, kept as code until the owner retires it (26 September
   2026): Home v2 is the Home now (DashboardPage), and this one has no
   address, so nothing reaches it while the application runs; nothing of it
   is dropped. *@
@implements IAsyncDisposable
@using WslcAgent.ApiClient
@inject WslcAgentApi Api
@inject IDialogService Dialogs
@inject SessionState Session
@inject DashboardPreference Cards
@inject AlarmReadings Watch
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject FileTransfers Transfers
@inject AgentChanges Changes

@* The reference's Home as a dashboard (the owner, 20 September 2026): the six
   overview cards (the four resources open their page), and what its one
   metrics panel showed one chart at a time — CPU and memory, disk and network
   activity (sampled while their card is on screen, the history kept while
   Home stays open), and WSLC storage (loaded once, with Refresh in the verbs
   menu) — as cards, all on screen at once. A chart card is a sparkline; its
   Open verb shows the full chart.

   Two modes (docs/home/spec.md, section 5). View, which Home opens in: a tap
   selects a card and the round button offers Open beside the page's verbs.
   Edit, in the URL as ?mode=edit so Back leaves it: the cards are dragged
   to the cell the user wants them in and resized by their corner, Settings
   is the selected card's verb, and one large button over the page adds a
   card (+) or takes the selected one off (−). This device remembers the
   arrangement (DashboardPreference) the moment each change is made.

   The grid is ours (DashboardLayout places, wslcAgent.dashboardGrid measures
   its columns and carries the drag): a card stands in the cell it was put
   in, so its place is written on its box — the one inline style in the
   application, because a cell is data the user chose, not a look. The
   client download and the client's version live on the System card, which is
   always there (the owner, 24 September 2026); the reference's Architecture button
   is a verb of every screen (ArchitectureVerb), and the bottom bar shows the
   alarms ticked in Edit's Status alarms (StatusAlarms). *@
<PageShell Title="Dashboard Overview">
    <Verbs>
        @if (_editing)
        {
            <VerbFab StartIcon="@Icons.Material.Filled.Check" Label="Done" Color="Color.Primary" OnClick="LeaveEdit"
                     Title="Back to the dashboard; every change is already saved" />
            @if (_part is not null)
            {
                <VerbFab StartIcon="@Icons.Material.Filled.Tune" Label="Settings" OnClick="OpenPartSettingsAsync" Title="@($"{SelectedName}, {_part}: its size in the card")" />
            }
            else if (SelectedCard is not null)
            {
                <VerbFab StartIcon="@Icons.Material.Filled.Tune" Label="Settings" OnClick="OpenSettingsAsync" Title="@($"{SelectedName}: its size")" />
            }
            else
            {
                @* Copy writes over the other place's dashboard: an edit of the
                   dashboard, so it lives in Edit, with nothing selected (the
                   owner, 22 September 2026). *@
                @* Which of the view's alarms the bottom bar shows (the owner,
                   22 September 2026), on every screen. *@
                <VerbFab StartIcon="@Icons.Material.Filled.NotificationsActive" Label="Status alarms" OnClick="OpenStatusAlarmsAsync"
                         Title="Choose which of this view's alarms the bottom bar shows" />
                <VerbFab StartIcon="@Icons.Material.Filled.ContentCopy"
                         Label="@(Cards.Scope == DashboardScope.User ? "Copy to device" : "Copy to server")" OnClick="CopyScopeAsync"
                         Title="@(Cards.Scope == DashboardScope.User
                                    ? "Write this dashboard over the one this device keeps, and stay with the user's"
                                    : "Write this dashboard over the one the user keeps, and stay with this device's")" />
            }
        }
        else if (SelectedKind is { } kind)
        {
            @* View with a card selected: that card's verbs alone (the owner,
               22 September 2026); the dashboard's own come back when nothing
               is selected. A resource's card offers its family's page verbs,
               the very ones its list page does — its own row verbs stand on
               the card itself — and no Open verb: a second tap opens its
               family's page, as it opens any card. *@
            @switch (kind.Key)
            {
                case DashboardCatalogue.Container:
                    <ContainersVerbs Changed="@(() => RefreshResourceNowAsync(DashboardCatalogue.Container))" />
                    break;
                case DashboardCatalogue.Image:
                    <ImagesVerbs Changed="@(() => RefreshResourceNowAsync(DashboardCatalogue.Image))" />
                    break;
                case DashboardCatalogue.Volume:
                    <VolumesVerbs Changed="@(() => RefreshResourceNowAsync(DashboardCatalogue.Volume))" />
                    break;
                case DashboardCatalogue.Network:
                    <NetworksVerbs Changed="@(() => RefreshResourceNowAsync(DashboardCatalogue.Network))" />
                    break;
            }
            @if (Opens(kind) && !kind.IsResource)
            {
                <VerbFab StartIcon="@Icons.Material.Filled.Launch" Label="Open" OnClick="OpenSelectedAsync"
                         Title="@(kind.IsChart ? "Open the full chart" : kind.Href.Length > 0 ? $"Open {kind.Label}" : "What this reading is made of")" />
            }
            @if (IsStorage(kind))
            {
                <VerbFab StartIcon="@Icons.Material.Filled.Refresh" Label="Refresh storage" OnClick="@(() => LoadStorageAsync(force: true))"
                         Title="Read the image catalog and the session stores again" />
            }
        }
        else
        {
            <VerbFab StartIcon="@Icons.Material.Filled.Refresh" Label="Refresh storage" OnClick="@(() => LoadStorageAsync(force: true))"
                     Title="Read the image catalog and the session stores again" />
            <VerbFab StartIcon="@Icons.Material.Filled.DashboardCustomize" Label="Edit" OnClick="EnterEdit"
                     Title="Arrange the dashboard: move, resize, add and hide cards" />
            @* Where this device keeps the dashboard (docs/home/spec.md, section 7):
               the verb says which it is now, and which of its two views is on
               screen — the one place either is named (the owner, 22 September
               2026: not the title, not Edit) — and switches to the other place. *@
            <VerbFab StartIcon="@(Cards.Scope == DashboardScope.User ? Icons.Material.Filled.Cloud : Icons.Material.Filled.Devices)"
                     Label="@ScopeLabel" OnClick="SwitchScopeAsync"
                     Title="@(Cards.Scope == DashboardScope.User
                                ? "Kept with the user on the agent, the same on every client; tap to keep it on this device instead"
                                : "Kept on this device alone; tap to keep it with the user, the same on every client")" />
        }
    </Verbs>
    <ChildContent>
        @* A tap on the page around the cards lets the selected one go. *@
        <div class="wslc-fill-scroll wslc-dash-pane" @onclick="Deselect">
            @* No limits of its own (the owner, 22 September 2026: a card is as
               large as the user wants it); the columns the dashboard has are
               the only bound, and the helper reads those from the grid. *@
            @* The grid stands from the first render, because it is what the
               browser measures; the cards wait for that measure (the owner,
               22 September 2026): until the view is known — this window a
               phone's or not — and its arrangement read from where the
               dashboard is kept, nothing is drawn, and while the window is
               being changed the cards come off until it settles, so they are
               placed and shown one time instead of at every width on the way. *@
            <div class="@GridClass" style="@GridColumns" @ref="_gridRef">
                @foreach (var placed in Cards.Placed)
                {
                    <div class="wslc-dash-item" style="@Area(placed)" @key="placed.Card.Id"
                         data-id="@placed.Card.Id" data-x="@placed.X" data-y="@placed.Y" data-w="@placed.W" data-h="@placed.H">
                        <DashboardSlot Signature="@Signature(placed)" Visible="@IsVisible(placed.Card.Id)">
                            @Card(placed)
                        </DashboardSlot>
                    </div>
                }
            </div>
        </div>
        @* Edit's one button (the owner, 22 September 2026): a large FAB in the
           corner, dragged wherever the hand wants it and remembered there on
           this device (wslcAgent.dashboardFab). With nothing selected it is +
           and opens the list of cards; with a card selected it is − in the
           error colour and takes that card off, after asking. *@
        @if (_editing)
        {
            <div class="wslc-dash-fab" @ref="_fabRef">
                @if (SelectedKind is { } selectedKind)
                {
                    @* The System card is always there: its − stands greyed and says so. *@
                    <MudFab Color="Color.Error" StartIcon="@Icons.Material.Filled.Remove" Size="Size.Large" OnClick="RemoveSelectedAsync" Disabled="selectedKind.IsFixed"
                            title="@(selectedKind.IsFixed ? $"{SelectedName} is always on the dashboard: move it or resize it" : $"Take {SelectedName} off the dashboard")" aria-label="Remove the selected card" />
                }
                else
                {
                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Large" OnClick="OpenCardsAsync"
                            title="Cards: which the dashboard shows" aria-label="Cards" />
                }
            </div>
        }
    </ChildContent>
</PageShell>

@code {
    /// <summary>The reference's chart history: two minutes at its default refresh.</summary>
    private const int MaxPoints = 120;

    /// <summary>The reference's default refresh interval; the User settings will set it.</summary>
    private static readonly TimeSpan Every = TimeSpan.FromSeconds(5);

    /// <summary>The agent's files on the move, for the ring a container's card wears; the queue behind them is this client's.</summary>
    private IReadOnlyList<ContainerTransfer> _transfers = [];

    /// <summary>The one container the transfers card is filtered to; empty for all of them.</summary>
    private string _transfersOf = "";

    /// <summary>
    /// The containers by their own names, for the transfers card: a transfer
    /// carries the container as the client that started it named it, and that
    /// is its id as often as not. Nobody remembers an id.
    /// </summary>
    private IReadOnlyList<ContainerSummary> _named = [];

    private readonly List<HomeRuntime> _runtime = [];
    private readonly List<HomeIo> _io = [];
    private readonly CancellationTokenSource _stop = new();
    private ElementReference _gridRef;
    private ElementReference _fabRef;
    private DotNetObjectReference<Home>? _self;
    private IJSObjectReference? _gridJs;
    private bool _fabWired;
    private HomeOverview? _overview;
    private HomeStorage? _storage;
    private DashboardResources _resources = default!;
    private bool _failed;
    private string? _status;
    private string? _storageStatus;
    private bool _storageError;
    private bool _editing;
    private string? _selected;
    private string? _part;

    /// <summary>
    /// The cards on screen or near it, by id, as the grid's observer reports
    /// them (wslcAgent.dashboardGrid); null until it first has, when every card
    /// counts as seen. What is not seen is neither read from the agent nor
    /// drawn (the owner, 24 September 2026).
    /// </summary>
    private HashSet<string>? _seen;

    /// <summary>The page is out of sight — another tab, the app in the background, the phone's screen off — and nothing is read or drawn until it is back.</summary>
    private bool _pageHidden;

    /// <summary>One beat at a time: the timer's, or one asked for when a card comes into sight or the page comes back.</summary>
    private readonly SemaphoreSlim _sampling = new(1, 1);

    /// <summary>When the last beat began, so cards scrolling into sight one after another ask for one beat and not one each.</summary>
    private DateTimeOffset _sampledAt;

    // What each source has become, counted up only when it changed: the cards'
    // signatures are made of these, so a beat that brought nothing new draws
    // nothing (DashboardSlot).
    private int _overviewVersion;
    private int _runtimeVersion;
    private int _ioVersion;
    private int _storageVersion;
    private int _transfersVersion;
    private string _transfersRead = "";
    private readonly Dictionary<string, (string Read, int Version)> _families = [];

    /// <summary>The view is not settled: the window has never been measured, or it is being changed right now.</summary>
    private bool _placing = true;

    /// <summary>
    /// The arrangement has been read from where the dashboard is kept. The page
    /// renders at the first await of its initialisation and the grid is measured
    /// then, before that read answers: without this the default set was shown
    /// for a moment, every card at its standard size, and then swapped for the
    /// user's own (the owner, 23 September 2026).
    /// </summary>
    private bool _arranged;

    /// <summary>
    /// The grid's classes: Edit's extra room below the cards, and, while the view
    /// is not settled or its arrangement not read yet, the class that takes the
    /// cards out of sight. They stay in the page while hidden on purpose — taken
    /// out, the pane's scrollbar would come and go, the grid would measure one
    /// width with them and another without, and the two would chase each other.
    /// </summary>
    private string GridClass =>
        $"wslc-dash-grid{(_editing ? " wslc-dash-editing" : "")}{(_placing || !_arranged ? " wslc-dash-placing" : "")}";

    /// <summary>The mode is the address's: <c>?mode=edit</c> is Edit, anything else View.</summary>
    [SupplyParameterFromQuery(Name = "mode")] public string? ModeQuery { get; set; }

    /// <summary>The scope verb's words: where the dashboard is kept, in brackets the view on screen, and where a tap takes it — "Dashboard: device (mobile) → server".</summary>
    private string ScopeLabel =>
        $"Dashboard: {(Cards.Scope == DashboardScope.User ? "server" : "device")} ({(Cards.View == DashboardView.Mobile ? "mobile" : "desktop")}) → {(Cards.Scope == DashboardScope.User ? "device" : "server")}";

    private DashboardCard? SelectedCard => Cards.Find(_selected);

    private CardKind? SelectedKind => SelectedCard is null ? null : DashboardCatalogue.Find(SelectedCard.Card);

    /// <summary>What the selected card is called in a verb or a question: a resource by its name now, from the registry, any other card by its kind.</summary>
    private string SelectedName => SelectedCard is { } card && _resources.NameOf(card) is { } name ? name : SelectedKind?.Label ?? "";

    private long[] RuntimeTimes => _runtime.Select(s => s.Timestamp).ToArray();

    private long[] IoTimes => _io.Select(s => s.Timestamp).ToArray();

    private double[][] CpuValues => [_runtime.Select(s => s.CpuUsedPercent).ToArray()];

    private double[][] MemoryValues => [_runtime.Select(s => (double)s.MemoryUsedBytes).ToArray()];

    private double[][] DiskValues => [_io.Select(s => (double)s.DiskReadBytes).ToArray(), _io.Select(s => (double)s.DiskWriteBytes).ToArray()];

    private double[][] NetworkValues => [_io.Select(s => (double)s.NetworkReceivedBytes).ToArray(), _io.Select(s => (double)s.NetworkSentBytes).ToArray()];

    private string CpuValue => _runtime.LastOrDefault() is { } r ? Readings.Cpu(r) : "—";

    private string MemoryValue => _runtime.LastOrDefault() is { } m ? Bytes.Humanize(m.MemoryUsedBytes) : "—";

    private string DiskValue => _io.LastOrDefault() is { } d ? $"{Bytes.Humanize(d.DiskReadBytes)} / {Bytes.Humanize(d.DiskWriteBytes)}" : "—";

    private string NetworkValue => _io.LastOrDefault() is { } n ? $"{Bytes.Humanize(n.NetworkReceivedBytes)} / {Bytes.Humanize(n.NetworkSentBytes)}" : "—";

    /// <summary>The overview's counters and readings are on their way: asked for and not answered, nor failed.</summary>
    private bool OverviewLoading => _overview is null && !_failed;

    /// <summary>
    /// A chart waits for its first sample while the session runs; a stopped
    /// session is not sampled, so its chart does not wait for one, and a
    /// failed sample says so in the hint instead.
    /// </summary>
    private bool RuntimeLoading => Session.Active && _runtime.Count == 0 && _status is null;

    private bool IoLoading => Session.Active && _io.Count == 0 && _status is null;

    /// <summary>The storage cards wait for their one read, until it answers or fails.</summary>
    private bool StorageLoading => _storage is null && !_storageError;

    /// <summary>
    /// A card of that kind is on the dashboard and in sight: what is read from
    /// the agent is what a card on screen shows, and a card that comes into
    /// sight asks for a beat at once (VisibleChangedAsync).
    /// </summary>
    private bool Seen(string kind) => Cards.Cards.Any(card => card.Card == kind && IsVisible(card.Id));

    private bool IsVisible(string id) => _seen is null || _seen.Contains(id);

    /// <summary>The CPU and memory readings are sampled too, not only their charts: their values are live, and their alarms watch them.</summary>
    private bool RuntimeWanted =>
        Seen("cpu-chart") || Seen("memory-chart") || Seen("cpu") || Seen("memory")
        || Seen(DashboardCatalogue.CpuAlarm) || Seen(DashboardCatalogue.MemoryAlarm) || Seen(DashboardCatalogue.System);

    /// <summary>The drive is read while Disk space is in sight, whether the session runs or not: it is the host's.</summary>
    private bool DiskWanted =>
        Seen(DashboardCatalogue.DiskSpace) || Seen(DashboardCatalogue.DiskAlarm) || Seen(DashboardCatalogue.System);

    /// <summary>The last CPU and memory reading: the latest sample, or the overview's until the first one arrives.</summary>
    private HomeRuntime? RuntimeNow => _runtime.LastOrDefault() ?? (_overview is { Runtime.Error: false } o ? o.Runtime : null);

    /// <summary>The card's alarm is up: any of the measures it watches is past its threshold (AlarmReadings, shared with the bottom bar).</summary>
    private bool InAlarm(DashboardCard card) => Watch.InAlarm(card);


    /// <summary>
    /// An alarm card (the owner, 22 September 2026): its measure as a ring
    /// alone, the one the containers' cards wear, red and blinking past its
    /// threshold like any card. Its tooltip names the reading and the threshold.
    /// </summary>
    private RenderFragment AlarmCard(PlacedCard placed)
    {
        var measure = DashboardCatalogue.Measures(placed.Card.Card)[0];
        var label = DashboardCatalogue.MeasureLabel(measure);
        var value = Watch.MeasureOf(placed.Card, measure);
        var setting = DashboardCatalogue.AlarmSetting(placed.Card, measure);
        var title = $"{label} {(value is { } shown ? Percents.Text(shown) : "not known yet")}; {(setting.Off ? "the alarm is off" : $"the alarm is past {setting.Threshold}%")}";
        var loading = measure == DashboardCatalogue.DiskMeasure ? Watch.Disk is null : RuntimeLoading;
        return @<HomeCard Label="@($"{label} alarm")" Frame="@Frame(placed)" Value="@(value is { } v ? Percents.Text(v) : "—")" Loading="loading">
            <Body>
                <div class="wslc-alarm-ring">
                    <UsageDial Label="@label" Reading="@(value is { } r ? Percents.Text(r) : "")" Live="@(value is not null)" Size="Size.Large" Title="@title" />
                </div>
            </Body>
        </HomeCard>;
    }

    private bool IoWanted => Seen("disk-chart") || Seen("network-chart");

    private bool StorageWanted => Cards.Cards.Any(card => IsStorage(DashboardCatalogue.Find(card.Card)) && IsVisible(card.Id));

    /// <summary>A storage card: loaded once, with Refresh storage as its own verb.</summary>
    private static bool IsStorage(CardKind? kind) => kind?.Key.StartsWith("storage-", StringComparison.Ordinal) == true;

    /// <summary>A family of resources is read only while a card of it is in sight.</summary>
    private IReadOnlyList<string> ResourcesWanted =>
        [.. DashboardCatalogue.Resources.Select(kind => kind.Key).Where(Seen)];

    /// <summary>The files on the move are read only while a card that shows them is in sight: their own, or a container's wearing their ring.</summary>
    private bool TransfersWanted => Seen(DashboardCatalogue.Transfers) || Seen(DashboardCatalogue.Container);

    /// <summary>
    /// The containers the card can be filtered to: the ones that have
    /// something of their own right now, moving or waiting. Not every
    /// container there is — a filter that lists forty names to say that one of
    /// them is busy is a worse list than no filter.
    /// </summary>
    private IReadOnlyList<string> TransferContainers =>
        [.. TransferFlow.Showing(_transfers).Select(transfer => transfer.Container)
            .Distinct(StringComparer.Ordinal)
            .OrderBy(container => container, StringComparer.OrdinalIgnoreCase)];

    /// <summary>
    /// The filter in force: the container the user chose while it still has
    /// files of its own, and all of them once it has none. A container that
    /// finishes goes from the list, and a card left sitting on a name that is
    /// no longer offered would look empty for good.
    /// </summary>
    private string TransfersFilter =>
        _transfersOf.Length > 0 && TransferContainers.Contains(_transfersOf, StringComparer.Ordinal) ? _transfersOf : "";

    /// <summary>What the card lists of the agent's: everything worth showing, or one container's when the filter names one.</summary>
    private IReadOnlyList<ContainerTransfer> TransfersShown =>
        TransferFlow.Showing(_transfers.Where(transfer => TransfersFilter.Length == 0 || transfer.Container == TransfersFilter));

    /// <summary>What a container is called on the card: its own name, and its id when nothing here knows better.</summary>
    private string NameOf(string container) =>
        _named.FirstOrDefault(row => row.Id == container || row.Name == container)?.Name is { Length: > 0 } name ? name : container;

    /// <summary>What the card says under its count: the container the filter names, or how many containers the files are spread over.</summary>
    private string TransfersHint =>
        TransfersFilter.Length > 0 ? $"in and out of {NameOf(TransfersFilter)}"
        : TransfersShown.Count == 0 ? "nothing on the move"
        : $"across {TransferContainers.Count} container{(TransferContainers.Count == 1 ? "" : "s")}";

    private void OnTransfersFilterChanged(string container)
    {
        _transfersOf = container;
        StateHasChanged();
    }

    private Task CancelTransferAsync(ContainerTransfer transfer) => TransferFlow.CancelAsync(Dialogs, Api, Snackbar, Transfers, [transfer]);

    private Task DismissTransferAsync(ContainerTransfer transfer) => TransferFlow.DismissAsync(Api, Snackbar, Transfers, [transfer]);

    private Task DropQueuedFile(ContainerTransfer waiting) => TransferFlow.DropAsync(Dialogs, Transfers, [waiting]);

    /// <summary>
    /// Whether a second tap opens the card (the owner, 22 September 2026): a
    /// chart its full chart, a counter its page, a resource's card its
    /// family's page, and any other — a reading, a storage card, an alarm —
    /// what its reading is made of. Only a resource's card opens nothing from
    /// the round button, since its family's verbs stand there.
    /// </summary>
    private static bool Opens(CardKind kind) => !kind.IsResource;

    protected override async Task OnInitializedAsync()
    {
        _resources = new DashboardResources(Api);
        Cards.Changed += OnCardsChanged;
        // The queue is this client's and no poll hears about it: a file chosen
        // or let go changes a card's ring this second, not in five.
        Transfers.QueueChanged += OnQueueChanged;
        // The dashboard written on another client arrives as the agent's notice.
        Changes.Changed += OnAgentChanged;
        Changes.Start();
        await Cards.ReadyAsync();
        _arranged = true;
        _ = SampleLoopAsync(_stop.Token);
        _ = LoadStorageIfWantedAsync();
        try
        {
            _overview = await Api.GetHomeOverviewAsync(_stop.Token);
            _overviewVersion++;
            Watch.Report(_overview.Runtime);
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            // Refused: the sign-in screen takes over; anything else leaves every card Unavailable.
            _failed = !ex.IsSignInRequired();
            _overviewVersion++;
        }
    }

    /// <summary>The address is the mode: Back, Forward and a link all arrive here. Changing mode lets the selection go.</summary>
    protected override void OnParametersSet()
    {
        var editing = string.Equals(ModeQuery, "edit", StringComparison.OrdinalIgnoreCase);
        if (editing != _editing)
        {
            _editing = editing;
            _selected = null;
            _part = null;
        }
    }

    /// <summary>
    /// The grid measures its columns and carries the drag from the first render
    /// on (wslcAgent.dashboardGrid); Edit's button is wired each time Edit
    /// begins, since it exists only then (wslcAgent.dashboardFab).
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _self = DotNetObjectReference.Create(this);
                _gridJs = await Js.InvokeAsync<IJSObjectReference>("wslcAgent.dashboardGrid", _gridRef, _self);
            }

            if (_editing && !_fabWired)
            {
                _fabWired = true;
                await Js.InvokeVoidAsync("wslcAgent.dashboardFab", _fabRef);
            }
            else if (!_editing)
            {
                _fabWired = false;
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // The page left while this was in flight.
        }
    }

    /// <summary>
    /// The grid has this many columns now, in a window that is a phone's or not:
    /// the cards are placed for them, from the arrangement of that view. A view
    /// that changed — a window narrowed, a phone turned — lets the selection go,
    /// since the other view holds other cards, and loads that view from where
    /// the dashboard is kept, the device or the server (the owner, 22 September
    /// 2026), not from this device's copy of it.
    /// </summary>
    [JSInvokable]
    public async Task ColumnsChangedAsync(int columns, bool mobile)
    {
        if (Cards.Fit(columns, mobile))
        {
            _selected = null;
            _part = null;
            await Cards.RefreshAsync(always: true);
        }

        _placing = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The window is being changed — an edge dragged, a phone turned — and what
    /// it will settle at is not known yet (the owner, 22 September 2026). The
    /// cards come off until it does, so the dashboard is not seen rearranging
    /// itself at every width on the way; the selection goes with them, since the
    /// view it was made in may not be the one that comes back.
    /// </summary>
    [JSInvokable]
    public Task ResizingAsync()
    {
        _placing = true;
        _selected = null;
        _part = null;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>A card was let go over a cell.</summary>
    [JSInvokable]
    public Task MovedAsync(string id, int x, int y) => Cards.MoveAsync(id, x, y);

    /// <summary>Edit begins on the dashboard as it is kept now, not on this device's last copy of it: another device may have saved since.</summary>
    private async Task EnterEdit()
    {
        await Cards.RefreshAsync();
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("mode", "edit"));
    }

    private void LeaveEdit() => Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("mode", (string?)null));

    /// <summary>
    /// The grid's columns when the cards reach past what the window shows
    /// (the owner, 22 September 2026: every card keeps its place, and the
    /// dashboard scrolls sideways): as many as they reach, each at the
    /// narrowest a column may be. Otherwise the stylesheet's own, which fill
    /// the width. Data the user's arrangement sets, as a card's place is.
    /// </summary>
    private string? GridColumns =>
        Cards.Width > Cards.Columns && Cards.Columns > 0 ? $"grid-template-columns: repeat({Cards.Width}, var(--wslc-dash-column))" : null;

    /// <summary>The card's cells, as the grid reads them: its place when it has one, its span alone while the columns are not measured yet.</summary>
    private static string Area(PlacedCard placed) =>
        placed.X < 0
            ? $"grid-column: span {placed.W}; grid-row: span {placed.H}"
            : $"grid-area: {placed.Y + 1} / {placed.X + 1} / span {placed.H} / span {placed.W}";

    private HomeCard.CardFrame Frame(PlacedCard placed) => new(
        placed.Card.Id,
        placed.W,
        placed.H,
        Selected: placed.Card.Id == _selected,
        Editing: _editing,
        Parts: Cards.PartsOf(placed.Card),
        SelectedPart: placed.Card.Id == _selected ? _part : null,
        SelectAsync,
        ResizeAsync,
        SelectPartAsync,
        Cards.MovePartAsync,
        Cards.ResizePartAsync,
        Alarm: InAlarm(placed.Card),
        Settings: OpenFocusedSettingsAsync);

    /// <summary>The gear on what has the focus: the taken part's Settings, or the card's.</summary>
    private Task OpenFocusedSettingsAsync() => _part is not null ? OpenPartSettingsAsync() : OpenSettingsAsync();

    /// <summary>
    /// A tap takes the card. A second tap on the same card opens it in View
    /// (its Open verb, when it has one: the owner, 22 September 2026) and lets
    /// it go in Edit, where a tap is for arranging.
    /// </summary>
    private async Task SelectAsync(string id)
    {
        // A part has the focus: a tap on the card's floor gives it back to the card.
        if (_part is not null && _selected == id)
        {
            _part = null;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (_selected == id && !_editing && SelectedKind is { } kind && Opens(kind))
        {
            await OpenSelectedAsync();
            return;
        }

        _selected = _selected == id ? null : id;
        _part = null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>A tap around the cards lets go of whatever has the focus.</summary>
    private void Deselect()
    {
        _selected = null;
        _part = null;
    }

    private Task ResizeAsync(string id, int columns, int rows) => Cards.ResizeAsync(id, columns, rows);

    /// <summary>
    /// A tap on a part of the selected card gives it the focus (the owner,
    /// 22 September 2026); on the part that has it, gives it back to the card.
    /// The card's parts are written down the first time one is taken, so the
    /// hand changes those.
    /// </summary>
    private async Task SelectPartAsync(string cardId, string key)
    {
        if (cardId != _selected)
        {
            return;
        }

        await Cards.StartLayoutAsync(cardId);
        _part = _part == key ? null : key;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The taken part's Settings: its size and its type size. Hiding it is the card's Settings' business (the owner, 22 September 2026).</summary>
    private async Task OpenPartSettingsAsync()
    {
        if (_selected is not { } cardId || _part is not { } key)
        {
            return;
        }

        var parameters = new DialogParameters<PartSettingsDialog> { { d => d.CardId, cardId }, { d => d.PartKey, key } };
        await DialogFlow.ShowMovableAsync<PartSettingsDialog>(Dialogs, $"{SelectedName}: {DashboardCatalogue.PartLabel(key)}", parameters);
    }

    /// <summary>Edit's Status alarms: the view's alarms, ticked while the bottom bar shows them.</summary>
    private Task OpenStatusAlarmsAsync() => DialogFlow.ShowPersistentAsync<StatusAlarmsDialog>(Dialogs, "Status alarms");

    /// <summary>Edit's + button: the list of kinds, ticked while on the dashboard.</summary>
    private Task OpenCardsAsync() => DialogFlow.ShowPersistentAsync<CardsDialog>(Dialogs, "Cards");

    /// <summary>
    /// The other place, this device's own storage or the user's on the agent
    /// (docs/home/spec.md, section 7): it shows what that place holds, asks
    /// nothing and writes nothing (the owner, 22 September 2026). Edit then
    /// edits there.
    /// </summary>
    private async Task SwitchScopeAsync()
    {
        await Cards.UseAsync(Cards.Scope == DashboardScope.User ? DashboardScope.Device : DashboardScope.User);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// The dashboard on screen written to the other place, this one staying
    /// where it is (the owner, 22 September 2026). It overwrites what is
    /// there, so it asks when there is something to overwrite.
    /// </summary>
    private async Task CopyScopeAsync()
    {
        var other = Cards.Scope == DashboardScope.User ? DashboardScope.Device : DashboardScope.User;
        var there = other == DashboardScope.User ? "the user" : "this device";
        if (await Cards.PeekAsync(other) is { Length: > 0 }
            && !await DialogFlow.ConfirmAsync(Dialogs, "Copy the dashboard", $"Write this dashboard over the one {there} keeps? That one cannot be brought back.", "Copy", destructive: true))
        {
            return;
        }

        await Cards.CopyToAsync(other);
        Snackbar.Add($"Dashboard copied to {there}.", Severity.Success);
    }

    private Task OpenSettingsAsync() =>
        SelectedCard is { } card && SelectedKind is { } kind
            ? DialogFlow.ShowMovableAsync<CardSettingsDialog>(Dialogs, SelectedName, new DialogParameters<CardSettingsDialog> { { d => d.CardId, card.Id } })
            : Task.CompletedTask;

    /// <summary>Edit's − button: the selected card off the dashboard, after asking; the selection goes with it.</summary>
    private async Task RemoveSelectedAsync()
    {
        if (SelectedCard is not { } card || SelectedKind is not { IsFixed: false })
        {
            return;
        }

        if (await DialogFlow.ConfirmAsync(Dialogs, "Remove card", $"Take {SelectedName} off the dashboard? It can be added again from the + button.", "Remove", destructive: true))
        {
            _selected = null;
            await Cards.HideAsync(card.Id);
        }
    }

    /// <summary>Open, the selected card's verb: its page for a counter, the full chart for a chart.</summary>
    private Task OpenSelectedAsync()
    {
        if (SelectedCard is not { } card || SelectedKind is not { } kind)
        {
            return Task.CompletedTask;
        }

        switch (card.Card)
        {
            case "cpu-chart":
                return OpenChartAsync("CPU", CpuValue, "percent", 100, HostSeries.Cpu, RuntimeTimes, CpuValues);
            case "memory-chart":
                return OpenChartAsync("Memory", MemoryValue, "bytes", null, HostSeries.Memory, RuntimeTimes, MemoryValues);
            case "disk-chart":
                return OpenChartAsync("Disk", DiskValue, "bytes", null, HostSeries.Disk, IoTimes, DiskValues);
            case "network-chart":
                return OpenChartAsync("Network", NetworkValue, "bytes", null, HostSeries.Network, IoTimes, NetworkValues);
            default:
                if (kind.Href.Length > 0)
                {
                    Navigation.NavigateTo(kind.Href);
                    return Task.CompletedTask;
                }

                // A reading, a storage card, an alarm: what its number is made of.
                return ReadingFacts.ShowAsync(Dialogs, card, Watch, _storage, SelectedName);
        }
    }

    /// <summary>One card per kind; the set, the places and the sizes are the user's. A Large chart carries its legend with the last readings.</summary>
    private RenderFragment Card(PlacedCard placed)
    {
        var card = placed.Card;
        return card.Card switch
        {
        "containers" => @<HomeCard Label="Containers" Frame="@Frame(placed)" Loading="OverviewLoading" Error="@(_overview?.Containers.Error ?? _failed)"
                                   Value="@(_overview is null ? "—" : $"{_overview.Containers.Running} / {_overview.Containers.Total}")" Hint="@Hint("running / total")" />,
        "images" => @<HomeCard Label="Images" Frame="@Frame(placed)" Loading="OverviewLoading" Error="@(_overview?.Images.Error ?? _failed)"
                               Value="@(_overview is null ? "—" : $"{_overview.Images.Count}")" Hint="@Hint($"{Bytes.Humanize(_overview?.Images.SizeBytes ?? 0)} catalog", _overview?.Images.Error)" />,
        "networks" => @<HomeCard Label="Networks" Frame="@Frame(placed)" Loading="OverviewLoading" Error="@(_overview?.Networks.Error ?? _failed)"
                                 Value="@(_overview is null ? "—" : $"{_overview.Networks.Count}")" Hint="@Hint("networks", _overview?.Networks.Error)" />,
        "volumes" => @<HomeCard Label="Volumes" Frame="@Frame(placed)" Loading="OverviewLoading" Error="@(_overview?.Volumes.Error ?? _failed)"
                                Value="@(_overview is null ? "—" : $"{_overview.Volumes.Count}")" Hint="@Hint("volumes", _overview?.Volumes.Error)" />,
        "cpu" => @<HomeCard Label="Aggregate CPU" Frame="@Frame(placed)" Loading="OverviewLoading" Error="@(_overview?.Runtime.Error ?? _failed)"
                            Value="@(RuntimeNow is { } r ? Readings.Cpu(r) : "—")" Hint="@Hint($"{_overview?.Runtime.CpuCount} CPUs available", _overview?.Runtime.Error)" />,
        "memory" => @<HomeCard Label="Aggregate memory" Frame="@Frame(placed)" Loading="OverviewLoading" Error="@(_overview?.Runtime.Error ?? _failed)"
                               Value="@(RuntimeNow is { } m ? Bytes.Humanize(m.MemoryUsedBytes) : "—")"
                               Hint="@Hint(RuntimeNow is { MemoryTotalBytes: > 0 } t ? $"of {Bytes.Humanize(t.MemoryTotalBytes)}, across containers" : "across containers", _overview?.Runtime.Error)" />,
        DashboardCatalogue.DiskSpace => @<HomeCard Label="Disk space" Frame="@Frame(placed)" Loading="@(Watch.Disk is null)" Error="@(Watch.Disk?.Error == true)"
                                                   Value="@(Watch.Disk is { Error: false } d ? $"{Bytes.Humanize(d.UsedBytes)} / {Bytes.Humanize(d.TotalBytes)}" : "—")"
                                                   Hint="@(Watch.Disk is not { } disk ? "Loading…" : Watch.DiskPercent is { } used ? $"{used:0}% of {disk.Drive} used" : "Unavailable")" />,
        "cpu-chart" => @<HomeCard Label="CPU" Frame="@Frame(placed)" Value="@CpuValue" Hint="@SampleHint("aggregate, last two minutes")" Error="_status is not null" Loading="RuntimeLoading">
            <Body>
                <LineChart Compact="true" Title="CPU" Format="percent" YMax="100" Series="HostSeries.Cpu" Times="@RuntimeTimes" Values="@CpuValues" />
            </Body>
            <Legend>
                <ChartLegend Series="HostSeries.Cpu" Format="percent" Values="@CpuValues" WithValues="true" />
            </Legend>
        </HomeCard>,
        "memory-chart" => @<HomeCard Label="Memory" Frame="@Frame(placed)" Value="@MemoryValue" Hint="@SampleHint("aggregate, last two minutes")" Error="_status is not null" Loading="RuntimeLoading">
            <Body>
                <LineChart Compact="true" Title="Memory" Format="bytes" Series="HostSeries.Memory" Times="@RuntimeTimes" Values="@MemoryValues" />
            </Body>
            <Legend>
                <ChartLegend Series="HostSeries.Memory" Format="bytes" Values="@MemoryValues" WithValues="true" />
            </Legend>
        </HomeCard>,
        "disk-chart" => @<HomeCard Label="Disk" Frame="@Frame(placed)" Value="@DiskValue" Hint="@SampleHint("read / write")" Error="_status is not null" Loading="IoLoading">
            <Body>
                <LineChart Compact="true" Title="Disk" Format="bytes" Series="HostSeries.Disk" Times="@IoTimes" Values="@DiskValues" />
            </Body>
            <Legend>
                <ChartLegend Series="HostSeries.Disk" Format="bytes" Values="@DiskValues" WithValues="true" />
            </Legend>
        </HomeCard>,
        "network-chart" => @<HomeCard Label="Network" Frame="@Frame(placed)" Value="@NetworkValue" Hint="@SampleHint("RX / TX")" Error="_status is not null" Loading="IoLoading">
            <Body>
                <LineChart Compact="true" Title="Network" Format="bytes" Series="HostSeries.Network" Times="@IoTimes" Values="@NetworkValues" />
            </Body>
            <Legend>
                <ChartLegend Series="HostSeries.Network" Format="bytes" Values="@NetworkValues" WithValues="true" />
            </Legend>
        </HomeCard>,
        "storage-images" => @<HomeCard Label="Image catalog" Frame="@Frame(placed)" Loading="StorageLoading" Error="@(_storageError || _storage?.Images.Error == true)"
                                       Value="@(_storage is null ? "—" : _storage.Images.Error ? "Unavailable" : Bytes.Humanize(_storage.Images.SizeBytes))"
                                       Hint="@StorageHint(_storage is null ? "" : $"{_storage.Images.Count} images")" />,
        "storage-vhdx" => @<HomeCard Label="Session VHDX" Frame="@Frame(placed)" Loading="StorageLoading" Error="@(_storageError || _storage?.Vhdx.Error.Length > 0)"
                                     Value="@(_storage is null ? "—" : _storage.Vhdx.Error.Length > 0 ? _storage.Vhdx.Error : Bytes.Humanize(_storage.Vhdx.TotalBytes))"
                                     Hint="@StorageHint("allocated, not free host disk")" />,
        "storage-swap" => @<HomeCard Label="Storage / swap" Frame="@Frame(placed)" Loading="StorageLoading" Error="@(_storageError || _storage?.Vhdx.Error.Length > 0)"
                                     Value="@(_storage is null || _storage.Vhdx.Error.Length > 0 ? "—" : $"{Bytes.Humanize(_storage.Vhdx.TotalStorageBytes)} / {Bytes.Humanize(_storage.Vhdx.TotalSwapBytes)}")"
                                     Hint="@StorageHint("of the session VHDX")" />,
        @* Every file travelling in or out of any container, which until now
           could only be read one container at a time, from the magnifier of
           its ring: the whole queue in one place, filtered to one container
           when that is what is wanted, and a cross on every line — the ones
           the agent carries are cancelled, the ones still waiting here are
           taken out of the queue (the owner, 23 September 2026). *@
        DashboardCatalogue.Transfers => @<HomeCard Label="File transfers" Frame="@Frame(placed)"
                                                   Value="@($"{TransfersShown.Count}")"
                                                   Hint="@TransfersHint">
            <Body>
                @* The filter is a verb of the card, not a part of its reading:
                   its taps stop here so choosing a container does not select
                   the card underneath. *@
                @if (TransferContainers is { Count: > 1 } containers)
                {
                    <VerbTaps>
                        <MudSelect T="string" Value="TransfersFilter" ValueChanged="OnTransfersFilterChanged" Margin="Margin.Dense" Dense="true"
                                   Variant="Variant.Filled" Label="Container">
                            <MudSelectItem T="string" Value="@("")">All containers</MudSelectItem>
                            @foreach (var container in containers)
                            {
                                <MudSelectItem T="string" Value="@container">@NameOf(container)</MudSelectItem>
                            }
                        </MudSelect>
                    </VerbTaps>
                }
                @* Everyone's, and every one of them cancellable: this card is
                   the administrator's view of the queue, which is what it was
                   asked for (docs/transfers-queue.md). A container's own
                   screens show the cross only on that client's files. *@
                <VerbTaps>
                    <TransfersList Transfers="TransfersShown" Where="true" Everyone="true" Names="NameOf"
                                   EmptyText="@(TransfersFilter.Length > 0 ? $"Nothing is moving in or out of {NameOf(TransfersFilter)}." : "Nothing is moving in or out of any container.")"
                                   Cancel="CancelTransferAsync" Dismiss="DismissTransferAsync" Drop="DropQueuedFile" />
                </VerbTaps>
            </Body>
        </HomeCard>,
        "storage-sessions" => @<HomeCard Label="Session stores" Frame="@Frame(placed)" Loading="StorageLoading" Error="@(_storageError || _storage?.Vhdx.Error.Length > 0)"
                                         Value="@(_storage is null || _storage.Vhdx.Error.Length > 0 ? "—" : $"{_storage.Vhdx.Sessions.Count}")"
                                         Hint="@StorageHint(_storage is { Vhdx.Sessions.Count: 0 } ? "No session stores found." : "VHDX per session")">
            <Body>
                @if (_storage is { Vhdx.Sessions.Count: > 0 })
                {
                    var largest = Math.Max(1, _storage.Vhdx.Sessions.Max(s => s.TotalBytes));
                    <div class="wslc-dash-bars">
                        @foreach (var session in _storage.Vhdx.Sessions)
                        {
                            <div class="wslc-home-bar">
                                <MudText Typo="Typo.body2" Class="wslc-home-bar-name" title="@session.Name">@(session.Name.Length > 0 ? session.Name : "default")</MudText>
                                <MudProgressLinear Value="@(100.0 * session.TotalBytes / largest)" Color="Color.Primary" Size="Size.Large" Rounded="true" />
                                <MudText Typo="Typo.body2" Class="wslc-home-bar-size">@Bytes.Humanize(session.TotalBytes)</MudText>
                            </div>
                        }
                    </div>
                }
            </Body>
        </HomeCard>,
        DashboardCatalogue.CpuAlarm or DashboardCatalogue.MemoryAlarm or DashboardCatalogue.DiskAlarm => AlarmCard(placed),
        DashboardCatalogue.System => @<SystemHomeCard Frame="@Frame(placed)" Card="card" />,
        _ when card.Ref is { } reference => ResourceCard(placed, reference.Uid),
        _ => @<text></text>,
        };
    }

    /// <summary>
    /// A resource's card (docs/home/spec.md, section 3): the list page's own
    /// card in the dashboard's parts (ResourceHomeCard), so the dashboard shows
    /// everything the list does, with nothing written twice. Its name and state
    /// come from the family's list, which the agent's registry numbers, so a
    /// rename or a recreate shows here as it happens. Before the list is read
    /// it says so; a resource removed is not drawn, and its card leaves the
    /// dashboard with the list that says it is gone.
    /// </summary>
    private RenderFragment ResourceCard(PlacedCard placed, int uid)
    {
        var kind = placed.Card.Card;
        Func<Task> changed = () => RefreshResourceNowAsync(kind);
        switch (kind)
        {
            case DashboardCatalogue.Container when _resources.Container(uid) is { } c:
                return @<ResourceHomeCard Frame="@Frame(placed)" Title="@c.Name" Subtitle="@c.Image" AvatarColor="@StateColors.For(c.State)" Key="@c.Id" State="@c.State"
                                          Avatar="@TransferRing(c.Id, c.Name)">
                    <Body><ContainerCardBody Container="c" /></Body>
                    <Actions><ContainerActions Container="c" Changed="changed" Shortcuts="true" /></Actions>
                </ResourceHomeCard>;
            case DashboardCatalogue.Image when _resources.Image(uid) is { } i:
                return @<ResourceHomeCard Frame="@Frame(placed)" Title="@i.Repository" Subtitle="@Readings.Dash(i.Tag)" AvatarColor="@(i.InUse ? Color.Success : Color.Default)" Key="@i.Reference" State="@(i.InUse ? "in use" : "")">
                    <Body><ImageCardBody Image="i" /></Body>
                    <Actions><ImageActions Image="i" Changed="changed" Shortcuts="true" /></Actions>
                </ResourceHomeCard>;
            case DashboardCatalogue.Volume when _resources.Volume(uid) is { } v:
                return @<ResourceHomeCard Frame="@Frame(placed)" Title="@v.Name" Subtitle="@v.Driver" AvatarColor="@(v.InUse ? Color.Success : Color.Default)" Key="@v.Name" State="@(v.InUse ? "in use" : "")">
                    <Body><VolumeCardBody Volume="v" TotalRead="@_resources.Volumes!.DiskReadBytes" TotalWritten="@_resources.Volumes!.DiskWriteBytes" /></Body>
                    <Actions><VolumeActions Volume="v" Changed="changed" Shortcuts="true" /></Actions>
                </ResourceHomeCard>;
            case DashboardCatalogue.Network when _resources.Network(uid) is { } n:
                return @<ResourceHomeCard Frame="@Frame(placed)" Title="@n.Name" Subtitle="@n.Driver" AvatarColor="@(n.InUse ? Color.Success : Color.Default)" Key="@n.Name" State="@(n.InUse ? "in use" : "")">
                    <Body><NetworkCardBody Network="n" TotalReceived="@_resources.Networks!.NetReceivedBytes" TotalSent="@_resources.Networks!.NetSentBytes" /></Body>
                    <Actions><NetworkActions Network="n" Changed="changed" /></Actions>
                </ResourceHomeCard>;
            default:
                return _resources.IsRead(kind)
                    ? @<text></text>
                    : @<HomeCard Label="@(DashboardCatalogue.Find(kind)?.Label ?? kind)" Frame="@Frame(placed)" Value="—"
                                 Hint="@(_resources.Failed(kind) ? "Unavailable" : "Loading…")" Error="@_resources.Failed(kind)" Loading="@(!_resources.Failed(kind))" />;
        }
    }

    /// <summary>
    /// The ring a container's card wears while files travel in or out of it,
    /// where its avatar goes: the same ring, the same tooltip and the same
    /// verbs as its row in the list, so a card on the dashboard says what the
    /// list says. Nothing at all when the container has nothing moving and
    /// nothing waiting, and then the avatar is the avatar.
    /// </summary>
    private RenderFragment? TransferRing(string id, string name)
    {
        var moving = TransferFlow.Showing(TransferFlow.For(_transfers, id, name));
        if (moving.Count == 0)
        {
            return null;
        }

        return @<ProgressRing Pct="@TransferFlow.Pct(moving)" Status="@TransferFlow.Status(moving)" Failed="@TransferFlow.Failed(moving)"
                              LogTitle="View the transfers" CancelTitle="@(TransferFlow.Active(moving) is { Count: > 1 } several ? $"Cancel {several.Count} transfers" : "Cancel transfer")"
                              DismissTitle="Dismiss"
                              OnLog="@(() => TransferFlow.ShowAsync(Dialogs, id, name))"
                              OnCancel="@(() => TransferFlow.StopAsync(Dialogs, Api, Snackbar, Transfers, moving))"
                              OnDismiss="@(() => TransferFlow.DismissAsync(Api, Snackbar, Transfers, moving))" />;
    }

    private string Hint(string text, bool? error = false) =>
        _failed || error == true ? "Unavailable" : _overview is null ? "Loading…" : text;

    /// <summary>What a chart card says under its value: the sampling's last error, or the reading's meaning.</summary>
    private string SampleHint(string text) => _status ?? text;

    /// <summary>What a storage card says under its value: loading, the last error, or the reading's meaning.</summary>
    private string StorageHint(string text) => _storageStatus ?? (_storage is null ? "Loading…" : text);

    private Task OpenChartAsync(string title, string value, string format, double? yMax, LineChart.Line[] series, long[] times, double[][] values) =>
        ChartDialog.ShowAsync(Dialogs, title, value, format, yMax, series, times, values);

    /// <summary>This client's queue changed: a container's ring and the transfers card say so this second, not in five.</summary>
    private void OnQueueChanged() => _ = InvokeAsync(() =>
    {
        _transfersVersion++;
        StateHasChanged();
    });

    /// <summary>The set, a place or a size changed: a card that is gone is no longer selected, and a storage card that just appeared gets its data.</summary>
    private void OnCardsChanged() => _ = InvokeAsync(() =>
    {
        if (SelectedCard is null)
        {
            _selected = null;
            _part = null;
        }

        StateHasChanged();
        return Task.WhenAll(ResourcesWanted.Where(kind => !_resources.IsRead(kind)).Select(RefreshResourceNowAsync).Append(LoadStorageIfWantedAsync()));
    });

    /// <summary>
    /// The agent says the dashboard the user keeps on it was written, here or
    /// on another client: it is read again now, instead of on every beat. Not
    /// in Edit, where the dashboard is this client's to change.
    /// </summary>
    private void OnAgentChanged(ChangeNotice notice)
    {
        if (notice.Touches(ChangeNotice.Dashboard) && !_editing)
        {
            _ = InvokeAsync(() => Cards.RefreshAsync());
        }
    }

    /// <summary>
    /// The grid's observer says which cards are on screen or near it
    /// (wslcAgent.dashboardGrid). One that came into sight is drawn as it is
    /// now, and a beat reads what it shows unless one has just begun.
    /// </summary>
    [JSInvokable]
    public async Task VisibleChangedAsync(string[] ids)
    {
        var came = _seen is not null && ids.Any(id => !_seen.Contains(id));
        _seen = [.. ids];
        if (came)
        {
            await InvokeAsync(StateHasChanged);
            await BeatSoonAsync();
            await LoadStorageIfWantedAsync();
        }
    }

    /// <summary>
    /// The page went out of sight or came back (wslcAgent.dashboardGrid): out
    /// of sight nothing is read or drawn (the owner, 24 September 2026), and
    /// back it is brought up to date at once rather than at the next beat.
    /// </summary>
    [JSInvokable]
    public async Task PageVisibleChangedAsync(bool visible)
    {
        _pageHidden = !visible;
        if (visible)
        {
            await InvokeAsync(StateHasChanged);
            await BeatSoonAsync();
        }
    }

    /// <summary>A beat on the refresh interval while the page is in sight; none while it is not.</summary>
    private async Task SampleLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(Every);
        try
        {
            do
            {
                if (!_pageHidden)
                {
                    await _sampling.WaitAsync(cancellationToken);
                    try
                    {
                        _sampledAt = DateTimeOffset.UtcNow;
                        await SampleAsync(cancellationToken);
                    }
                    finally
                    {
                        _sampling.Release();
                    }
                }
            }
            while (await timer.WaitForNextTickAsync(cancellationToken));
        }
        catch (OperationCanceledException)
        {
            // Home closed.
        }
    }

    /// <summary>
    /// A beat between the timer's, for a card come into sight or the page come
    /// back: let go when one is under way or began a moment ago, which reads
    /// for it — cards scrolling in one after another ask for one beat, not one each.
    /// </summary>
    private async Task BeatSoonAsync()
    {
        if (DateTimeOffset.UtcNow - _sampledAt < Soon || !_sampling.Wait(0))
        {
            return;
        }

        try
        {
            _sampledAt = DateTimeOffset.UtcNow;
            await SampleAsync(_stop.Token);
        }
        catch (OperationCanceledException)
        {
            // Home closed.
        }
        finally
        {
            _sampling.Release();
        }
    }

    /// <summary>How recent a beat has to be for one asked for between the timer's to be let go.</summary>
    private static readonly TimeSpan Soon = TimeSpan.FromSeconds(1);

    /// <summary>
    /// One beat: what the cards in sight show, read at once — nothing here
    /// waits on anything else — and the page drawn once, each card only if
    /// what it shows changed (DashboardSlot).
    /// </summary>
    private async Task SampleAsync(CancellationToken cancellationToken)
    {
        // What another client saved arrives as the agent's notice
        // (OnAgentChanged); only while those notices are not coming is it
        // asked for on the beat. Not in Edit, where it is this client's to change.
        if (!_editing && !Changes.Live)
        {
            await Cards.RefreshAsync();
        }

        // A stopped session holds nothing to sample, and asking would open it
        // again: the page keeps what it has until the session is back. The
        // drive and the files on the move are the host's and the agent's, and
        // are read whatever the session does.
        var session = Session.Active;
        await Task.WhenAll(
            TransfersWanted ? ReadTransfersAsync(cancellationToken) : Task.CompletedTask,
            DiskWanted ? ReadDiskAsync(cancellationToken) : Task.CompletedTask,
            session ? ReadResourcesAsync(ResourcesWanted, cancellationToken) : Task.CompletedTask,
            session && RuntimeWanted ? ReadRuntimeAsync(cancellationToken) : Task.CompletedTask,
            session && IoWanted ? ReadIoAsync(cancellationToken) : Task.CompletedTask);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The agent's files on the move, and the containers' names for the transfers card; counted as new only when they are.</summary>
    private async Task ReadTransfersAsync(CancellationToken cancellationToken)
    {
        try
        {
            var transfers = await Api.GetContainerTransfersAsync(cancellationToken);
            // Only the card needs the names; a container's own card wears the
            // ring and never says whose it is.
            var named = Seen(DashboardCatalogue.Transfers)
                ? (await Api.GetContainersAsync(all: true, cancellationToken: cancellationToken)).Containers
                : _named;
            var read = System.Text.Json.JsonSerializer.Serialize(new { transfers, named = named.Select(row => new { row.Id, row.Name }) });
            (_transfers, _named) = (transfers, named);
            if (read != _transfersRead)
            {
                _transfersRead = read;
                _transfersVersion++;
            }
        }
        catch (Exception ex) when ((ex is AgentApiException or HttpRequestException) && !ex.IsSignInRequired())
        {
            // The agent did not answer this beat; the next one asks again, and
            // a ring that stays as it was is better than one that blinks out
            // because one request was lost.
        }
        catch (Exception ex) when (ex.IsSignInRequired())
        {
            // The sign-in screen takes over.
        }
    }

    /// <summary>The drive is the host's: it is read whatever the session does.</summary>
    private async Task ReadDiskAsync(CancellationToken cancellationToken)
    {
        try
        {
            Watch.Report(await Api.GetHomeDiskAsync(cancellationToken));
        }
        catch (Exception ex) when ((ex is AgentApiException or HttpRequestException) && !ex.IsSignInRequired())
        {
            Watch.Report(new HomeDisk("", 0, 0, 0, Error: true));
        }
        catch (Exception ex) when (ex.IsSignInRequired())
        {
            // The sign-in screen takes over.
        }
    }

    private async Task ReadRuntimeAsync(CancellationToken cancellationToken)
    {
        try
        {
            var runtime = await Api.GetHomeRuntimeAsync(cancellationToken);
            Add(_runtime, runtime, s => s.Error);
            Watch.Report(runtime);
        }
        catch (Exception ex) when ((ex is AgentApiException or HttpRequestException) && !ex.IsSignInRequired())
        {
            _status = ex.Message;
        }
        catch (Exception ex) when (ex.IsSignInRequired())
        {
            // The sign-in screen takes over.
        }

        _runtimeVersion++;
    }

    private async Task ReadIoAsync(CancellationToken cancellationToken)
    {
        try
        {
            Add(_io, await Api.GetHomeIoAsync(cancellationToken), s => s.Error);
        }
        catch (Exception ex) when ((ex is AgentApiException or HttpRequestException) && !ex.IsSignInRequired())
        {
            _status = ex.Message;
        }
        catch (Exception ex) when (ex.IsSignInRequired())
        {
            // The sign-in screen takes over.
        }

        _ioVersion++;
    }

    /// <summary>
    /// The families of resources with a card in sight, read at once; what each
    /// read means for the dashboard is then taken one after another, since
    /// taking a removed resource's card off writes the dashboard.
    /// </summary>
    private async Task ReadResourcesAsync(IReadOnlyList<string> kinds, CancellationToken cancellationToken)
    {
        var reads = await Task.WhenAll(kinds.Select(async kind => (Kind: kind, Live: await _resources.RefreshAsync(kind, cancellationToken))));
        foreach (var (kind, live) in reads)
        {
            await TakeAsync(kind, live);
        }
    }

    /// <summary>
    /// One family of resources read again for its cards. A card whose uid is
    /// no longer there points at a resource that was removed, and leaves the
    /// dashboard — only on a list read in full with the session running, never
    /// on a read that failed or a session that is off.
    /// </summary>
    private async Task RefreshResourceAsync(string kind, CancellationToken cancellationToken)
    {
        if (Session.Active)
        {
            await TakeAsync(kind, await _resources.RefreshAsync(kind, cancellationToken));
        }
    }

    /// <summary>What a family's read means: the containers' readings for the alarms, the cards of what is gone taken off, and the family counted as new when it is.</summary>
    private async Task TakeAsync(string kind, IReadOnlySet<int>? live)
    {
        if (live is not null)
        {
            if (kind == DashboardCatalogue.Container && _resources.Containers is { } list)
            {
                Watch.Report(list.Containers);
            }

            await Cards.DropRemovedAsync(kind, live);
        }

        object? family = kind switch
        {
            DashboardCatalogue.Container => _resources.Containers,
            DashboardCatalogue.Image => _resources.Images,
            DashboardCatalogue.Volume => _resources.Volumes,
            DashboardCatalogue.Network => _resources.Networks,
            _ => null,
        };
        var read = $"{System.Text.Json.JsonSerializer.Serialize(family)} {_resources.Failed(kind)}";
        if (!_families.TryGetValue(kind, out var known) || known.Read != read)
        {
            _families[kind] = (read, known.Version + 1);
        }
    }

    /// <summary>
    /// What a card shows, as text, for DashboardSlot: its frame — size, focus,
    /// mode, parts, alarm — and how far each thing it reads has come. A beat
    /// that brought nothing new for it gives the same text, and it is not drawn.
    /// </summary>
    private string Signature(PlacedCard placed)
    {
        var card = placed.Card;
        var focus = card.Id == _selected ? $"selected {_part}" : "";
        return $"{placed.W}x{placed.H} {focus} {_editing} {InAlarm(card)} {string.Join(',', Cards.PartsOf(card))} | {Reads(card)}";
    }

    /// <summary>How far what the card reads has come: the versions of its sources, or the readings themselves where they are a few numbers.</summary>
    private string Reads(DashboardCard card) => card.Card switch
    {
        "containers" or "images" or "networks" or "volumes" => $"o{_overviewVersion}",
        "cpu" or "memory" => $"o{_overviewVersion} r{_runtimeVersion}",
        DashboardCatalogue.DiskSpace => $"{Watch.Disk}",
        "cpu-chart" or "memory-chart" => $"r{_runtimeVersion} {RuntimeLoading}",
        "disk-chart" or "network-chart" => $"i{_ioVersion} {IoLoading}",
        DashboardCatalogue.Transfers => $"t{_transfersVersion} {_transfersOf}",
        DashboardCatalogue.CpuAlarm or DashboardCatalogue.MemoryAlarm or DashboardCatalogue.DiskAlarm => AlarmReads(card),
        // It draws itself from the readings it watches (AlarmReadings).
        DashboardCatalogue.System => "",
        _ when IsStorage(DashboardCatalogue.Find(card.Card)) => $"s{_storageVersion}",
        _ when card.Ref is not null => $"f{(_families.TryGetValue(card.Card, out var family) ? family.Version : 0)} {_resources.IsRead(card.Card)} t{(card.Card == DashboardCatalogue.Container ? _transfersVersion : 0)}",
        _ => "",
    };

    private string AlarmReads(DashboardCard card)
    {
        var measure = DashboardCatalogue.Measures(card.Card)[0];
        return $"{Watch.MeasureOf(card, measure)} {DashboardCatalogue.AlarmSetting(card, measure)} {Watch.Disk is null} {RuntimeLoading}";
    }

    /// <summary>After a verb on a resource's card, or when one is added: its family again, and the cards drawn from it.</summary>
    private async Task RefreshResourceNowAsync(string kind)
    {
        await RefreshResourceAsync(kind, _stop.Token);
        await InvokeAsync(StateHasChanged);
    }

    private void Add<T>(List<T> history, T sample, Func<T, bool> failed)
    {
        if (failed(sample))
        {
            _status = "stats unavailable";
            return;
        }

        _status = null;
        history.Add(sample);
        if (history.Count > MaxPoints)
        {
            history.RemoveAt(0);
        }
    }

    private Task LoadStorageIfWantedAsync() => StorageWanted ? LoadStorageAsync(force: false) : Task.CompletedTask;

    private async Task LoadStorageAsync(bool force)
    {
        if (_storage is not null && !force)
        {
            return;
        }

        _storageStatus = "Loading storage…";
        _storageError = false;
        _storageVersion++;
        try
        {
            _storage = await Api.GetHomeStorageAsync(_stop.Token);
            _storageStatus = null;
        }
        catch (Exception ex) when (ex is AgentApiException or HttpRequestException)
        {
            // Refused: the sign-in screen takes over; this card says nothing of its own.
            if (!ex.IsSignInRequired())
            {
                _storageStatus = ex.Message;
                _storageError = true;
            }
        }

        _storageVersion++;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        Cards.Changed -= OnCardsChanged;
        Transfers.QueueChanged -= OnQueueChanged;
        Changes.Changed -= OnAgentChanged;
        // Cancelled, not disposed: a start still waiting on the dashboard asks for
        // the token after it has gone, and a disposed source throws there — the
        // layout brought down on a phone where the user tapped away while the app
        // was opening (the owner, 24 September 2026). One with no timer holds
        // nothing to let go of.
        _stop.Cancel();
        try
        {
            if (_gridJs is not null)
            {
                await _gridJs.InvokeVoidAsync("dispose");
                await _gridJs.DisposeAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException)
        {
            // The page is going away.
        }

        _self?.Dispose();
    }
}
