@page "/styles"
@using WslcAgent.UI.Components.Styles
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@* The living style guide: every control the application uses, rendered at
   the left with the values chosen at the right, where each property that
   changes the look can be tried at runtime. The values the application
   fixes are stated under each title (docs/ui-controls.md). *@
<PageShell Title="Styles">
    <TopbarSearch>
        <SearchBox @bind-Value="_search" Placeholder="Search controls" />
    </TopbarSearch>
    <ChildContent>
        <div class="wslc-styles">
            <StyleRow Title="Text" Fixed="Typo.h6 titles · body1 default · body2 data · caption secondary" Hidden="@(!Show("Text typography"))">
                <Control>
                    <MudText Typo="_text.Typo" Class="@(_text.Secondary ? "mud-text-secondary" : null)">The quick brown fox jumps over the lazy dog 0123456789</MudText>
                </Control>
                <Properties>
                    <PropSelect T="Typo" Label="Typo" @bind-Value="_text.Typo" />
                    <PropToggle Label="Secondary tone" @bind-Value="_text.Secondary" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Button" Fixed="Size.Small · Variant.Filled · Color: default, Primary (main verb), Error (destructive)" Hidden="@(!Show("Button"))">
                <Control>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="wslc-toolbar">
                        <PageStats><PageStat Label="In a header row" Value="26px, square corners" /></PageStats>
                        <MudButton Size="_button.Size" Variant="_button.Variant" Color="_button.Color" Disabled="_button.Disabled" StartIcon="@(_button.Icon ? WslcIcons.Create : null)">Create</MudButton>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">In a dialog</MudText>
                        <MudButton Size="_button.Size" Variant="_button.Variant" Disabled="_button.Disabled">Cancel</MudButton>
                        <MudButton Size="_button.Size" Variant="_button.Variant" Color="_button.Color" Disabled="_button.Disabled" StartIcon="@(_button.Icon ? WslcIcons.Create : null)">Create</MudButton>
                    </MudStack>
                </Control>
                <Properties>
                    <PropSelect T="Size" Label="Size" @bind-Value="_button.Size" />
                    <PropSelect T="Variant" Label="Variant" @bind-Value="_button.Variant" />
                    <PropSelect T="Color" Label="Color" @bind-Value="_button.Color" />
                    <PropToggle Label="StartIcon" @bind-Value="_button.Icon" />
                    <PropToggle Label="Disabled" @bind-Value="_button.Disabled" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Icon button" Fixed="Size.Small · title always · start Success, stop Primary, remove Error, the rest uncoloured" Hidden="@(!Show("Icon button actions"))">
                <Control>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <MudIconButton Icon="@_iconButton.Icon" Size="_iconButton.Size" Color="_iconButton.Color" Variant="_iconButton.Variant" Disabled="_iconButton.Disabled" title="Sample" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Row actions:</MudText>
                        <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                            <MudIconButton Icon="@WslcIcons.Start" Size="_iconButton.Size" Variant="_iconButton.Variant" Color="Color.Success" title="Start" />
                            <MudIconButton Icon="@WslcIcons.Stop" Size="_iconButton.Size" Variant="_iconButton.Variant" Color="Color.Primary" title="Stop" />
                            <MudIconButton Icon="@WslcIcons.Restart" Size="_iconButton.Size" Variant="_iconButton.Variant" title="Restart" />
                            <MudIconButton Icon="@WslcIcons.More" Size="_iconButton.Size" Variant="_iconButton.Variant" title="More actions" />
                            <MudIconButton Icon="@WslcIcons.Remove" Size="_iconButton.Size" Variant="_iconButton.Variant" Color="Color.Error" title="Remove" />
                        </MudStack>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Shell:</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="_iconButton.Size" Variant="_iconButton.Variant" title="Refresh" />
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Row remove:</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Class="wslc-row-remove" title="Remove row" />
                    </MudStack>
                </Control>
                <Properties>
                    <MudSelect T="string" Label="Icon" @bind-Value="_iconButton.Icon" Dense="true" Margin="Margin.Dense" Variant="Variant.Filled">
                        @foreach (var icon in WslcIcons.All())
                        {
                            <MudSelectItem T="string" Value="@icon.Value">@icon.Key</MudSelectItem>
                        }
                    </MudSelect>
                    <PropSelect T="Size" Label="Size" @bind-Value="_iconButton.Size" />
                    <PropSelect T="Variant" Label="Variant" @bind-Value="_iconButton.Variant" />
                    <PropSelect T="Color" Label="Color" @bind-Value="_iconButton.Color" />
                    <PropToggle Label="Disabled" @bind-Value="_iconButton.Disabled" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Action rail and log lines" Fixed="Size.Small · Variant.Filled · Material icons in the verb colours · a toggle is green and pressed in while on · lines coloured by level" Hidden="@(!Show("Action rail logs"))">
                <Control>
                    <div class="wslc-action-body">
                        <div class="wslc-action-main">
                            <div class="wslc-logs-output wslc-fill-scroll @(_rail.Wrap ? "wslc-logs-wrap" : null)">
                                <div class="wslc-log-line log-level-debug">2026-09-14 10:00:00 DEBUG a debug line</div>
                                <div class="wslc-log-line log-level-info">2026-09-14 10:00:01 INFO an info line</div>
                                <div class="wslc-log-line log-level-warning">2026-09-14 10:00:02 WARNING a warning line</div>
                                <div class="wslc-log-line log-level-error">2026-09-14 10:00:03 ERROR an error line</div>
                                <div class="wslc-log-line">2026-09-14 10:00:04 a line with no level</div>
                            </div>
                        </div>
                        <div class="wslc-action-rail" role="toolbar">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="@RailToggle.Color(_rail.Search)" Class="@RailToggle.Class(_rail.Search)" Size="Size.Small" Variant="Variant.Filled" title="Search / filter" OnClick="@(() => _rail.Search = !_rail.Search)" />
                            <MudIconButton Icon="@Icons.Material.Filled.WrapText" Color="@RailToggle.Color(_rail.Wrap)" Class="@RailToggle.Class(_rail.Wrap)" Size="Size.Small" Variant="Variant.Filled" title="Wrap" OnClick="@(() => _rail.Wrap = !_rail.Wrap)" />
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" title="Refresh" />
                            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" title="Copy" />
                            <MudIconButton Icon="@Icons.Material.Filled.ClearAll" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" title="Clear" />
                        </div>
                    </div>
                </Control>
                <Properties>
                    <PropToggle Label="Search toggle on" @bind-Value="_rail.Search" />
                    <PropToggle Label="Wrap toggle on" @bind-Value="_rail.Wrap" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Menu" Fixed="Size.Small · Dense · WslcIcons glyph on every item" Hidden="@(!Show("Menu"))">
                <Control>
                    <div>
                        <MudMenu Icon="@WslcIcons.More" Size="_menu.Size" Dense="_menu.Dense" Variant="_menu.Variant" Color="_menu.Color" title="More actions">
                            <MudMenuItem Icon="@WslcIcons.Details">View details</MudMenuItem>
                            <MudMenuItem Icon="@WslcIcons.ViewEdit">View &amp; edit</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@WslcIcons.Restart">Restart</MudMenuItem>
                            <MudMenuItem Icon="@WslcIcons.Kill" Disabled="true">Kill</MudMenuItem>
                        </MudMenu>
                    </div>
                </Control>
                <Properties>
                    <PropSelect T="Size" Label="Size" @bind-Value="_menu.Size" />
                    <PropSelect T="Variant" Label="Variant" @bind-Value="_menu.Variant" />
                    <PropSelect T="Color" Label="Color" @bind-Value="_menu.Color" />
                    <PropToggle Label="Dense" @bind-Value="_menu.Dense" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Text field" Fixed="Variant.Text · Margin.Dense · Label + Placeholder (example) + HelperText · search boxes through SearchBox (title bar)" Hidden="@(!Show("Text field textbox input search"))">
                <Control>
                    <div class="wslc-form-grid">
                        <MudTextField T="string" @bind-Value="_textField.Text" Label="Name" Placeholder="my-app" HelperText="@(_textField.Helper ? "Example: my-app" : null)"
                                      Variant="_textField.Variant" Margin="_textField.Margin" Required="_textField.Required" RequiredError="A name is required"
                                      ReadOnly="_textField.ReadOnly" Disabled="_textField.Disabled" Lines="_textField.Lines" Clearable="_textField.Clearable" Immediate="true" />
                        <MudTextField T="string" Value="@("prefilled")" Label="Image" ReadOnly="true" Variant="_textField.Variant" Margin="_textField.Margin" HelperText="@(_textField.Helper ? "Read-only value" : null)" />
                    </div>
                </Control>
                <Properties>
                    <PropSelect T="Variant" Label="Variant" @bind-Value="_textField.Variant" />
                    <PropSelect T="Margin" Label="Margin" @bind-Value="_textField.Margin" />
                    <PropNumber Label="Lines" @bind-Value="_textField.Lines" Min="1" Max="6" />
                    <PropToggle Label="HelperText" @bind-Value="_textField.Helper" />
                    <PropToggle Label="Required" @bind-Value="_textField.Required" />
                    <PropToggle Label="Clearable" @bind-Value="_textField.Clearable" />
                    <PropToggle Label="ReadOnly" @bind-Value="_textField.ReadOnly" />
                    <PropToggle Label="Disabled" @bind-Value="_textField.Disabled" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Multi-value field" Fixed="the list is the model · values on one line · ⋮ opens the list editor (Add · ✕ · Save / Close)" Hidden="@(!Show("Multi value field list editor rows"))">
                <Control>
                    <div class="wslc-form-grid">
                        <MultiValueField Values="_multiValue" Label="Publish" Split="ValueList.Split" Placeholder="8080:80"
                                         HelperText="Example: 8080:80. Several separated by commas, or edited as rows with ⋮."
                                         Hint="One port publication per row: [host:]hostPort:containerPort." />
                    </div>
                </Control>
                <Properties>
                    <PageStats>
                        <PageStat Label="Values" Value="@_multiValue.Count.ToString()" />
                    </PageStats>
                </Properties>
            </StyleRow>

            <StyleRow Title="Select" Fixed="Dense · Margin.Dense · Variant.Text · explicit T" Hidden="@(!Show("Select selector dropdown"))">
                <Control>
                    <div class="wslc-form-grid">
                        <MudSelect T="string" @bind-Value="_select.Value" Label="Restart policy" Dense="_select.Dense" Margin="_select.Margin" Variant="_select.Variant"
                                   Disabled="_select.Disabled" FullWidth="_select.FullWidth" HelperText="@(_select.Helper ? "Dashboard-owned; production container" : null)">
                            <MudSelectItem T="string" Value="@("no")">No</MudSelectItem>
                            <MudSelectItem T="string" Value="@("unless-stopped")">Unless stopped</MudSelectItem>
                            <MudSelectItem T="string" Value="@("always")">Always</MudSelectItem>
                        </MudSelect>
                    </div>
                </Control>
                <Properties>
                    <PropSelect T="Variant" Label="Variant" @bind-Value="_select.Variant" />
                    <PropSelect T="Margin" Label="Margin" @bind-Value="_select.Margin" />
                    <PropToggle Label="Dense" @bind-Value="_select.Dense" />
                    <PropToggle Label="FullWidth" @bind-Value="_select.FullWidth" />
                    <PropToggle Label="HelperText" @bind-Value="_select.Helper" />
                    <PropToggle Label="Disabled" @bind-Value="_select.Disabled" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Checkbox and switch" Fixed="Dense · Size.Small · Label · tooltip as title" Hidden="@(!Show("Checkbox switch"))">
                <Control>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudCheckBox T="bool" @bind-Value="_check.Checked" Dense="_check.Dense" Size="_check.Size" Color="_check.Color" Disabled="_check.Disabled" Label="Running" title="Show running containers only" />
                        <MudSwitch T="bool" @bind-Value="_check.Checked" Size="_check.Size" Color="_check.Color" Disabled="_check.Disabled" Label="Keep running" />
                    </MudStack>
                </Control>
                <Properties>
                    <PropSelect T="Size" Label="Size" @bind-Value="_check.Size" />
                    <PropSelect T="Color" Label="Color" @bind-Value="_check.Color" />
                    <PropToggle Label="Dense (checkbox)" @bind-Value="_check.Dense" />
                    <PropToggle Label="Disabled" @bind-Value="_check.Disabled" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Toggle group" Fixed="Size.Small · Color.Primary · Outlined · no delimiters · MudIcon children (ViewModeToggle)" Hidden="@(!Show("Toggle group view mode"))">
                <Control>
                    <div>
                        <MudToggleGroup T="ViewMode" @bind-Value="_toggle.Value" Size="_toggle.Size" Color="_toggle.Color" Outlined="_toggle.Outlined" Delimiters="_toggle.Delimiters" Class="@(_toggle.Rounded ? "rounded-pill" : null)" CheckMark="_toggle.CheckMark">
                            <MudToggleItem Value="ViewMode.Table" title="Table"><MudIcon Icon="@Icons.Material.Filled.TableRows" Size="Size.Small" /></MudToggleItem>
                            <MudToggleItem Value="ViewMode.Cards" title="Cards"><MudIcon Icon="@Icons.Material.Filled.GridView" Size="Size.Small" /></MudToggleItem>
                        </MudToggleGroup>
                    </div>
                </Control>
                <Properties>
                    <PropSelect T="Size" Label="Size" @bind-Value="_toggle.Size" />
                    <PropSelect T="Color" Label="Color" @bind-Value="_toggle.Color" />
                    <PropToggle Label="Outlined" @bind-Value="_toggle.Outlined" />
                    <PropToggle Label="Delimiters" @bind-Value="_toggle.Delimiters" />
                    <PropToggle Label="Rounded" @bind-Value="_toggle.Rounded" />
                    <PropToggle Label="CheckMark" @bind-Value="_toggle.CheckMark" />
                </Properties>
            </StyleRow>

            <StyleRow Title="State" Fixed="table: StateDot · cards and details: StateChip = Size.Small Variant.Filled Color from StateColors · details badge · ports link" Hidden="@(!Show("State chip dot badge ports"))">
                <Control>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                        <StateDot Active="true" Title="running" />
                        @foreach (var state in States)
                        {
                            <MudChip T="string" Size="_chip.Size" Variant="_chip.Variant" Color="@StateColors.For(state)">@state</MudChip>
                        }
                        <span class="wslc-details-state">running</span>
                        <PortsLink Ports="SamplePorts" />
                        <PortsLink Ports="NoPorts" />
                    </MudStack>
                </Control>
                <Properties>
                    <PropSelect T="Size" Label="Size" @bind-Value="_chip.Size" />
                    <PropSelect T="Variant" Label="Variant" @bind-Value="_chip.Variant" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Row on its way" Fixed="in a row: the name gives way, the percentage and the two verbs never do, the bar under them · in a card: the ring takes the avatar, with the percentage inside and the two verbs under it · the magnifier only where there is something behind it (a pull's console, a transfer's list) · error colour when it failed" Hidden="@(!Show("Progress pull run row"))">
                <Control>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Wrap="Wrap.Wrap">
                        @foreach (var width in ProgressWidths)
                        {
                            <div style="@($"width:{width}px")" class="wslc-styles-progress">
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@(width)px</MudText>
                                <ProgressCell Name="ghcr.io/open-webui/open-webui" Pct="42" Status="Pulling…" LogTitle="View pull output" CancelTitle="Cancel pull" OnLog="StyleNoop" />
                            </div>
                        }
                        <div style="width:180px" class="wslc-styles-progress">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">failed</MudText>
                            <ProgressCell Name="ghcr.io/open-webui/open-webui" Pct="42" Status="Pull failed: no such image" Failed="true" OnLog="StyleNoop" />
                        </div>
                        <div style="width:180px" class="wslc-styles-progress">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">nothing to open: no magnifier</MudText>
                            <ProgressCell Name="api" Pct="42" Status="Uploading app.tar.gz… → /opt/app.tar.gz" CancelTitle="Cancel transfer" />
                        </div>
                        <div style="width:250px" class="wslc-styles-progress">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">in a card: the avatar is the progress</MudText>
                            <EntityCard Title="ghcr.io/open-webui/open-webui" Subtitle="main" Key="styles-pull">
                                <Avatar><ProgressRing Pct="42" Status="Pulling layer 3 of 7" OnLog="StyleNoop" /></Avatar>
                                <ChildContent>
                                    <MudText Typo="Typo.body2"><b>Id</b> pending</MudText>
                                    <MudText Typo="Typo.body2"><b>Size</b> —</MudText>
                                </ChildContent>
                            </EntityCard>
                        </div>
                        <div style="width:250px" class="wslc-styles-progress">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">in a card, failed</MudText>
                            <EntityCard Title="ghcr.io/open-webui/open-webui" Subtitle="main" Key="styles-pull-failed">
                                <Avatar><ProgressRing Pct="42" Status="Pull failed: no such image" Failed="true" OnLog="StyleNoop" /></Avatar>
                                <ChildContent>
                                    <MudText Typo="Typo.body2"><b>Id</b> pending</MudText>
                                </ChildContent>
                            </EntityCard>
                        </div>
                    </MudStack>
                </Control>
            </StyleRow>

            <StyleRow Title="Table" Fixed="ListGrid: Striped · Bordered · FixedHeader · Elevation 1 · never Dense · cell padding 3px 8px (CSS)" Hidden="@(!Show("Table grid list"))">
                <Control>
                    <div class="wslc-fill">
                        <MudDataGrid T="ContainerSummary" Items="Containers" Striped="_grid.Striped" Bordered="_grid.Bordered" Hover="_grid.Hover" Dense="_grid.Dense"
                                     FixedHeader="_grid.FixedHeader" Elevation="_grid.Elevation" Outlined="_grid.Outlined" MultiSelection="true"
                                     SortMode="SortMode.Single" Filterable="false" Breakpoint="Breakpoint.None" ColumnResizeMode="ResizeMode.Container" ShowColumnOptions="false" RowsPerPage="10">
                            <Columns>
                                <SelectColumn T="ContainerSummary" Size="Size.Small" StickyLeft="true" HeaderClass="@GridColumn.Select" CellClass="@GridColumn.Select" />
                                <TemplateColumn T="ContainerSummary" Title="" Sortable="false" Resizable="false" StickyLeft="true" HeaderClass="@GridColumn.Bullet" CellClass="@GridColumn.Bullet">
                                    <CellTemplate><StateDot Active="context.Item.IsRunning" Title="running" /></CellTemplate>
                                </TemplateColumn>
                                <PropertyColumn T="ContainerSummary" TProperty="string" Property="c => c.Name" Title="Name" StickyLeft="true" HeaderClass="@GridColumn.Width(16)" CellClass="@GridColumn.Width(16)" />
                                <PropertyColumn T="ContainerSummary" TProperty="string" Property="c => c.Image" Title="Image" HeaderClass="@GridColumn.Width(24)" CellClass="@GridColumn.Width(24)" />
                                <PropertyColumn T="ContainerSummary" TProperty="string" Property="c => c.Id" Title="ID" HeaderClass="@GridColumn.Width(12)" CellClass="@($"{GridColumn.Width(12)} mud-text-secondary")" />
                                <TemplateColumn T="ContainerSummary" Title="Ports" Sortable="false" HeaderClass="@GridColumn.StretchNumber(10)" CellClass="@GridColumn.StretchNumber(10)">
                                    <CellTemplate><PortsLink Ports="context.Item.Ports" /></CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn T="ContainerSummary" Title="Actions" Sortable="false" Resizable="false" StickyRight="true" HeaderClass="@GridColumn.Actions" CellClass="@GridColumn.Actions">
                                    <CellTemplate>
                                        <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center">
                                            <MudIconButton Icon="@(context.Item.IsRunning ? WslcIcons.Stop : WslcIcons.Start)" Size="Size.Small" Color="@(context.Item.IsRunning ? Color.Primary : Color.Success)" title="@(context.Item.IsRunning ? "Stop" : "Start")" />
                                            <MudIconButton Icon="@WslcIcons.More" Size="Size.Small" title="More actions" />
                                            <MudIconButton Icon="@WslcIcons.Remove" Size="Size.Small" Color="Color.Error" title="Remove" />
                                        </MudStack>
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <PagerContent>
                                <MudDataGridPager T="ContainerSummary" PageSizeOptions="PageSizes" />
                            </PagerContent>
                        </MudDataGrid>
                    </div>
                </Control>
                <Properties>
                    <PropNumber Label="Elevation" @bind-Value="_grid.Elevation" Max="8" />
                    <PropToggle Label="Striped" @bind-Value="_grid.Striped" />
                    <PropToggle Label="Bordered" @bind-Value="_grid.Bordered" />
                    <PropToggle Label="Hover" @bind-Value="_grid.Hover" />
                    <PropToggle Label="Dense" @bind-Value="_grid.Dense" />
                    <PropToggle Label="FixedHeader" @bind-Value="_grid.FixedHeader" />
                    <PropToggle Label="Outlined" @bind-Value="_grid.Outlined" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Card" Fixed="EntityCard: Elevation 1 · header and actions rows in the header tone · body2 lines with a bold label" Hidden="@(!Show("Card"))">
                <Control>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="6" md="4">
                            <EntityCard Title="web" Subtitle="nginx:1.27" AvatarColor="_card.AvatarColor">
                                <HeaderActions><StateChip State="running" /></HeaderActions>
                                <ChildContent>
                                    <MudText Typo="Typo.body2"><b>Id</b> 4f2a9c1b7e3d</MudText>
                                    <MudText Typo="Typo.body2"><b>Ports</b> <PortsLink Ports="SamplePorts" /></MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Created 2 days ago</MudText>
                                </ChildContent>
                                <Actions>
                                    <MudIconButton Icon="@WslcIcons.Stop" Size="Size.Small" Color="Color.Primary" title="Stop" />
                                    <MudIconButton Icon="@WslcIcons.More" Size="Size.Small" title="More actions" />
                                    <MudIconButton Icon="@WslcIcons.Remove" Size="Size.Small" Color="Color.Error" title="Remove" />
                                </Actions>
                            </EntityCard>
                        </MudItem>
                    </MudGrid>
                </Control>
                <Properties>
                    <PropSelect T="Color" Label="AvatarColor" @bind-Value="_card.AvatarColor" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Tabs" Fixed="Elevation 0 · Rounded false · MinimumTabWidth 0 · one bordered card (CSS on .wslc-fill.mud-tabs)" Hidden="@(!Show("Tabs details"))">
                <Control>
                    <MudTabs Elevation="_tabs.Elevation" Rounded="_tabs.Rounded" Border="_tabs.Border" Centered="_tabs.Centered" Color="_tabs.Color" MinimumTabWidth="@(_tabs.MinimumWidth ? "160px" : "0")" TabPanelsClass="wslc-tab-panels" Class="wslc-fill">
                        <MudTabPanel Text="Logs"><EmptyState Text="Logs" /></MudTabPanel>
                        <MudTabPanel Text="Inspect"><EmptyState Text="Inspect" /></MudTabPanel>
                        <MudTabPanel Text="Bind mounts"><EmptyState Text="Bind mounts" /></MudTabPanel>
                    </MudTabs>
                </Control>
                <Properties>
                    <PropNumber Label="Elevation" @bind-Value="_tabs.Elevation" Max="8" />
                    <PropSelect T="Color" Label="Color" @bind-Value="_tabs.Color" />
                    <PropToggle Label="Rounded" @bind-Value="_tabs.Rounded" />
                    <PropToggle Label="Border" @bind-Value="_tabs.Border" />
                    <PropToggle Label="Centered" @bind-Value="_tabs.Centered" />
                    <PropToggle Label="MinimumTabWidth 160px" @bind-Value="_tabs.MinimumWidth" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Icons" Fixed="WslcIcons (the application's own glyphs): symbols take the current colour, pictograms keep theirs · Icons.Material.Filled for the shell only" Hidden="@(!Show("Icons glyphs"))">
                <Control>
                    <div class="wslc-style-icons">
                        @foreach (var icon in WslcIcons.All())
                        {
                            <span><MudIcon Icon="@icon.Value" Size="_icons.Size" Color="_icons.Color" /><MudText Typo="Typo.caption" Class="mud-text-secondary">@icon.Key</MudText></span>
                        }
                    </div>
                </Control>
                <Properties>
                    <PropSelect T="Size" Label="Size" @bind-Value="_icons.Size" />
                    <PropSelect T="Color" Label="Color" @bind-Value="_icons.Color" />
                </Properties>
            </StyleRow>

            <StyleRow Title="Feedback" Fixed="MudAlert Severity.Error above a grid · toasts top right over the title bar, in the verb's colour · MudProgressLinear above an empty list · a busy row action only disables its buttons" Hidden="@(!Show("Feedback alert snackbar toast progress dialog confirm"))">
                <Control>
                    <MudAlert Severity="_feedback.Severity" Variant="_feedback.Variant" Dense="_feedback.Dense" NoIcon="_feedback.NoIcon">The agent did not answer: connection refused.</MudAlert>
                    <MudProgressLinear Indeterminate="true" Color="_feedback.Color" />
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="_feedback.Color" />
